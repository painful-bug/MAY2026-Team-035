# HomeBandhu backend environment.
# Copy to `.env` and fill in values from your Supabase project settings.
# `.env` is git-ignored — never commit real keys.

# Supabase project (Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# JWT secret used to verify Supabase-issued access tokens (Settings -> API -> JWT Settings).
SUPABASE_JWT_SECRET=your-jwt-secret

# Where the React app is served — used to build resident invite links (/join/<token>).
FRONTEND_BASE_URL=http://localhost:5173

# Invitation lifetime in hours.
INVITE_TTL_HOURS=72

# CORS: comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# "development" or "production".
ENV=development
