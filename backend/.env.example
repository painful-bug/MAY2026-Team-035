# HomeBandhu backend environment.
# Copy to `.env` and fill in values from your Supabase project settings.
# `.env` is git-ignored — never commit real keys.

# Supabase project (Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Random 32+ byte secret used to sign OAuth and CSRF cookie transactions.
COOKIE_SIGNING_SECRET=replace-with-a-long-random-secret

# External callback base URL for the backend OAuth callback.
BACKEND_BASE_URL=http://localhost:8000

# Where the React app is served — used to build resident invite links (/join/<token>).
FRONTEND_BASE_URL=http://localhost:5173

# Invitation lifetime in hours.
INVITE_TTL_HOURS=72

# Authentication method order. Swap primary/secondary without changing UI or RBAC code.
AUTH_PRIMARY_METHOD=google
AUTH_ENABLED_METHODS=google,email_password
AUTH_SESSION_IDLE_DAYS=30
# Enable only after Supabase Auth CAPTCHA and the frontend Turnstile widget are configured.
AUTH_CAPTCHA_ENABLED=false
# Never allow a stalled identity-provider call to block the API event loop.
AUTH_PROVIDER_TIMEOUT_SECONDS=8

# Bounded typeahead result sizing for community join search.
COMMUNITY_SEARCH_DEFAULT_LIMIT=10
COMMUNITY_SEARCH_MAX_LIMIT=20

# CORS: comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# "development" or "production".
ENV=development

# Set true in production; the default follows ENV.
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Web Push (VAPID). Optional: leave these empty and push is simply off --
# GET /push/vapid-key and POST /push/subscriptions answer 503
# `push_not_configured`, the sender never starts, and nothing else changes.
#
# Generate a pair per environment, never shared:
#     python scripts/generate_vapid_keys.py
#
# It prints three lines and writes no file. Run it yourself; a development key
# used in production means a laptop can push to real residents' phones. See
# docs/design/RESIDENT_BACKEND_DESIGN.md 10.5.
#
# Rotating these silently unsubscribes every browser -- a subscription is bound
# to the key that created it and the protocol has no dual-key period. Treat it
# as incident response, not routine hygiene.
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https:// -- how a push service contacts us when something is wrong.
VAPID_SUBJECT=
