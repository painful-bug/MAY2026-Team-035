# Public Supabase browser credentials. Never place a service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Used only for server-side resident invitation redemption.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Swap these values to change which sign-in method is presented first.
VITE_AUTH_PRIMARY_PROVIDER=google
VITE_AUTH_SECONDARY_PROVIDER=otp
