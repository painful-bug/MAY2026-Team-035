' ===========================================================================
' ADMIN DASHBOARD (backend/planning/1)
'
' The seven routers the admin dashboard adds, with their services and adapters.
' Same three-layer shape as the auth/onboarding half above: a router does HTTP
' and authorization, a service holds the rule, a repository is the only thing
' that speaks to Postgres.
'
' Every write in this half goes through a SECURITY DEFINER RPC rather than a
' PostgREST insert, because each one touches more than one table and PostgREST
' has no client-side transaction. Reads go through security_invoker views, so
' RLS still decides what the caller sees.
' ===========================================================================
package "Presentation / API — admin dashboard" #F1F5F9 {
  class ComplaintsRouter <<router>> {
    + patch_complaint()
    + add_comment()
  }
  class DepartmentsRouter <<router>> {
    + list_departments()
    + create_department()
    + update_department()
    + delete_department()
    + replace_staff()
    + add_staff_member()
    + update_staff_member()
    + remove_staff_member()
  }
  class MoneyRouter <<router>> {
    + create_invoice()
    + record_payment()
    + get_billing_settings()
    + update_billing_settings()
  }
  class AmenitiesRouter <<router>> {
    + list_amenities()
    + save_amenity()
    + request_booking()
    + approve_booking()
    + reject_booking()
    + cancel_occurrences()
    + ledger()
    + reports()
  }
  class SettingsRouter <<router>> {
    + get_settings()
    + save_settings()
  }
  class NoticesRouter <<router>> {
    + create_notice()
  }
  class AdminsRouter <<router>> {
    + add_admin()
  }
}

package "Application services — admin dashboard" #FFF3E0 {
