  class AmenitiesService <<service>>
  class SettingsService <<service>>
  class NoticesService <<service>>
  class PeopleService <<service>>
  class Vocabularies <<value>> {
    + status_to_storage()
    + department_status_to_storage()
    + payment_method_to_storage()
    .. maps wire strings to the ..
    .. baseline's stored enums ..
  }
}

package "Persistence adapters — admin dashboard" #E2E8F0 {
  class ComplaintsRepository <<repository>>
  class DepartmentsRepository <<repository>>
  class MoneyRepository <<repository>>
  class AmenitiesRepository <<repository>>
  class SettingsRepository <<repository>>
  class NoticesRepository <<repository>>
  class TenancyRepository <<repository>> {
    + get_caller_community_id()
  }
}

package "Admin dashboard schema (0018-0023)" #FAFAFA {
  class "views
(security_invoker)" as AdminViews {
    department_overview
    department_staff_overview
    invoice_overview
    payment_overview
    community_settings_overview
    community_module_overview
    amenity_overview
    amenity_booking_overview
    amenity_ledger_overview
    amenity_ledger_summary
  }
  class "RPCs
(security definer)" as AdminRpcs {
    24 write functions
    guarded by is_community_admin()
  }
}

