title HomeBandhu — Current Application Class Diagram
caption Browser → FastAPI routers → services → repositories → Supabase.\nTenant authorization derives from an active community membership.

package "Browser (React/Vite)\nNo Supabase SDK or provider tokens" #E8F1FF {
  class ApiClient <<module>> {
    + api(path, options) : JSON
    - refresh() : Response
    - csrfToken() : String
  }
  class AuthStore <<Zustand store>> {
    + initializeAuth()
    + beginGoogleSignIn(next)
    + completeExternalLogin()
    + authGeneration : Number
    + logout()
  }
  class DashboardDataBootstrap <<React component>> {
    + refresh()
    + subscribeToDashboard()
  }
  class AppStore <<Zustand render cache>> {
    + hydrateDashboard(snapshot)
    + clearDashboard()
  }
  class RegistrationApi <<module>> {
    + searchCommunities(query)
    + createAccessRequest(body)
    + approveAccessRequest(id, {unit_code, building_code})
    + adminUnits()
    + createInvitation(body)
    .. createAccessRequest carries the free-text ..
    .. residence claim (requested_unit_text, ..
    .. + requested_building_text for apartments); ..
    .. adminUnits feeds the approval panel's ..
    .. matches-existing / will-create indicator ..
  }
  class AmenitiesService <<module>> {
    + listAmenities()
    + saveAmenity(body)
    + removeAmenity(id)
