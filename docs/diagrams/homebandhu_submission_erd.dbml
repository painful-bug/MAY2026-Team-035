// HomeBandhu — current clean-baseline ERD
// Source of truth: backend/supabase/migrations/0001_baseline.sql
// Paste into https://dbdiagram.io. Database: PostgreSQL.
//
// Renders (2026-08-11): erd.svg + erd.png beside this file, generated OFFLINE with
//   npx @softwaretechnik/dbml-renderer -i homebandhu_submission_erd.dbml -o erd.svg
//   (PNG via its -f dot output through Graphviz dot -Tpng -Gdpi=65).
// The previous erd.png was a dbdiagram.io export and had fallen far behind the source
// (it still showed vendors, pre-0034); it is preserved in docs/archives/. dbdiagram.io
// still accepts this file for a hand-arranged export if that style is preferred.
// NOTE: DBML single-quoted strings cannot contain a bare apostrophe — three notes
// were reworded on 2026-08-11 because ' inside 'note: ...' is a parse error.

Project homebandhu_submission_erd {
  database_type: 'PostgreSQL'
  Note: 'Current clean-baseline model. Supabase Auth identity is external auth.users; Google OAuth is primary and email/password is secondary. Community permissions come only from active community_memberships. PK = primary key, FK = foreign key, UQ = unique.'
}

Enum membership_role {
  resident
  worker
  security
  manager
  admin
}

Enum membership_status {
  pending
  active
  suspended
  ended
}

Enum invite_status {
  issued
  redeemed
  revoked
  expired
}

Enum residency_relationship {
  owner
  tenant
  family_member
  caregiver
  other
}

Enum complaint_status {
  open
  acknowledged
  in_progress
  resolved
  closed
  cancelled
}

Enum visitor_status {
  expected
  pending_approval
  approved
  denied
  checked_in
  checked_out
  expired
  cancelled
}

Enum booking_status {
  requested
  approved
  rejected
  cancelled
  completed
  no_show
}

Enum invoice_status {
  draft
  issued
  partially_paid
  paid
  overdue
  void
}

Enum payment_status {
  initiated
  succeeded
  failed
  refunded
}

// Identity, community, and residency
Table auth.users [headercolor: #102A43] {
  id uuid [pk]
  email text [unique]
  email_confirmed_at timestamptz
  created_at timestamptz
  Note: 'EXTERNAL: Supabase Auth. Google OAuth is primary; verified email/password is an optional secondary provider.'
}

Table profiles [headercolor: #102A43] {
  id uuid [pk, ref: - auth.users.id]
  full_name text
  display_email citext
  phone_e164 varchar(20)
  avatar_media_id uuid
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { display_email [unique, note: 'Partial: only when non-null'] }
  Note: 'Identity/contact record. It has no tenant role.'
}

Table communities [headercolor: #102A43] {
  id uuid [pk]
  name text [not null]
  community_type text [not null, note: 'apartment | layout_villa']
  status text [not null, default: 'active']
  address_line1 text [not null]
  address_line2 text
  city text [not null]
  state text [not null]
  postal_code text [not null]
  country_code char(2) [not null, default: 'IN']
  timezone text [not null, default: 'Asia/Kolkata']
  active_admin_membership_id uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table buildings [headercolor: #0F766E] {
  id uuid [pk]
  community_id uuid [not null, ref: > communities.id]
  name text [not null]
  code text [not null]
  building_type text [not null, default: 'block']
  map_x numeric(8,5)
  map_y numeric(8,5)
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (community_id, code) [unique] }
}

Table units [headercolor: #0F766E] {
  id uuid [pk]
  community_id uuid [not null, ref: > communities.id]
  building_id uuid [ref: > buildings.id]
  unit_code text [not null]
  unit_type text [not null, default: 'flat']
  floor_number text
  map_x numeric(8,5)
  map_y numeric(8,5)
  status text [not null, default: 'active']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (community_id, unit_code) [unique] }
}

Table feature_catalog [headercolor: #102A43] {
  code text [pk]
  name text [not null]
  description text [not null, default: '']
  default_enabled boolean [not null, default: false]
  is_active boolean [not null, default: true]
}

Table community_features [headercolor: #102A43] {
  community_id uuid [pk, not null, ref: > communities.id]
  feature_code text [pk, not null, ref: > feature_catalog.code]
  is_enabled boolean [not null]
  updated_by_membership_id uuid [ref: > community_memberships.id]
  updated_at timestamptz [not null]
}

Table departments [headercolor: #B7791F] {
  id uuid [pk]
  community_id uuid [not null, ref: > communities.id]
  name text [not null]
  description text
  category text
  hours jsonb [not null]
  manager_membership_id uuid [ref: > community_memberships.id]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  contact_email citext [note: '0019']
  contact_phone_e164 varchar(20) [note: '0019']
  opens_at time [note: '0019 - hours jsonb is the baseline column; these two are what the form writes']
  closes_at time [note: '0019']
  sla_hours integer [note: '0019 - 1..8760']
  kind text [note: '0035 - service | security. 0019 said internal|vendor|hybrid, which nothing ever wrote']
  status text [not null, default: 'active', note: '0019 - active | archived; a trigger keeps it and is_active in step']
  indexes {
    (community_id, name) [unique]
    (id, community_id) [unique, note: '0019 - the composite target child rows point at to prove tenancy without a join']
  }
  Note: 'The 0019 columns above were missing from this diagram until 2026-08-09. status and is_active say the same thing to two readers; sync_department_status() writes each from the other, so neither can drift.'
}

Table community_memberships [headercolor: #B7791F] {
  id uuid [pk]
  community_id uuid [not null, ref: > communities.id]
  profile_id uuid [not null, ref: > profiles.id]
  department_id uuid [ref: > departments.id]
  role membership_role [not null]
  status membership_status [not null, default: 'pending']
  joined_at timestamptz [not null]
  ended_at timestamptz
  is_default_community boolean [not null, default: false]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes {
    (community_id, profile_id) [unique, note: 'Partial: ended_at is null']
    profile_id [unique, note: 'Partial: active default membership']
  }
  Note: 'Tenant authorization source. A role is valid only on an active, non-ended membership.'
}

Table community_admin_terms [headercolor: #B7791F] {
  id uuid [pk]
  community_id uuid [not null, ref: > communities.id]
  admin_membership_id uuid [not null, ref: > community_memberships.id]
  designation text
  started_at timestamptz [not null]
  ended_at timestamptz
  transferred_by_membership_id uuid [ref: > community_memberships.id]
  transfer_note text
  indexes { community_id [unique, note: 'Partial: ended_at is null'] }
}

Table unit_residencies [headercolor: #0F766E] {
  id uuid [pk]
  unit_id uuid [not null, ref: > units.id]
  membership_id uuid [not null, ref: > community_memberships.id]
  relationship_type residency_relationship [not null]
  is_primary_contact boolean [not null, default: false]
  started_at date [not null]
  ended_at date
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (unit_id, membership_id) [unique, note: 'Partial: ended_at is null'] }

  // 0033 -- RLS, which this table had none of. It says who lives in which flat,
  // it is reachable through PostgREST, and until this migration every
  // authenticated user in the project could read all of it. A resident sees
  // their own flat's occupants; an admin sees the community's.
}

// 0033 -- extra numbers a household registers against its flat.
//
// NOT memberships, and the distinction is the whole reason this table exists.
// `Profile.jsx` lets a resident add a number without going through an admin, and
// the prototype implements it by inventing a whole user -- name, role, status.
// That cannot be done here: `profiles.id` references `auth.users`, so a person
// with no account cannot be a profile, and manufacturing a membership for a
// phone number would put somebody in the community's member count who cannot log
// in and never agreed to join.
//
// Scoped to the UNIT rather than to the resident who added it, because that is
// what the screen says -- "Numbers Registered to Flat B-1204". When they move
// out, the number belongs to the flat's history and not to them.
//
// `household_overview` unions these with real residencies and labels each row
// with a `source`, so a caller never has to guess which kind it is holding.
Table unit_contacts [headercolor: #0F766E] {
  id uuid [pk]
  community_id uuid [not null, ref: > communities.id]
  unit_id uuid [not null, ref: > units.id]
  added_by_membership_id uuid [ref: > community_memberships.id]
  full_name text [not null]
  phone_e164 varchar(20) [not null]
  relationship text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (unit_id, phone_e164) [unique, note: 'the same number twice is the same number'] }
}

// Joining and staffing
Table resident_invites [headercolor: #102A43] {
  id uuid [pk]
  community_id uuid [not null, ref: > communities.id]
  intended_unit_id uuid [ref: > units.id]
  invitee_email citext [not null]
  invitee_phone_e164 varchar(20)
  invitee_name text
  intended_role membership_role [not null, default: 'resident']
  token_hash text [not null, unique]
  code_hash text [not null, unique]
  status invite_status [not null, default: 'issued']
  expires_at timestamptz [not null]
  redeemed_at timestamptz
  redeemed_by_profile_id uuid [ref: > profiles.id]
  created_by_membership_id uuid [ref: > community_memberships.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: 'Stores only hashes. Redemption requires the invitee verified Google email.'
}

Table access_requests [headercolor: #102A43] {
  id uuid [pk]
  community_id uuid [not null, ref: > communities.id]
  requested_unit_id uuid [ref: > units.id]
  applicant_profile_id uuid [not null, ref: > profiles.id]
  applicant_name text [not null]
  applicant_email citext [not null]
  applicant_phone_e164 varchar(20)
  requested_relationship residency_relationship [not null, default: 'tenant']
  status text [not null, default: 'pending', note: 'pending | approved | rejected | withdrawn']
  reviewed_by_membership_id uuid [ref: > community_memberships.id]
  reviewed_at timestamptz
  rejection_reason text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (community_id, applicant_profile_id) [unique, note: 'Partial: status is pending'] }
}

Table blacklisted_residents [headercolor: #102A43] {
  id uuid [pk]
  community_id uuid [not null, ref: > communities.id]
  profile_id uuid [not null, ref: > profiles.id]
  blacklisted_by_membership_id uuid [not null, ref: > community_memberships.id]
  reason text [not null]
  created_at timestamptz [not null]
  revoked_at timestamptz
  revoked_by_membership_id uuid [ref: > community_memberships.id]
  Note: 'A reversible community-specific join blacklist. At most one active row per community and profile.'
}

// vendors was dropped by 0044 (superseded by service_providers, D1) along with
// staff_assignments.vendor_id, the only column that ever referenced it.

Table staff_assignments [headercolor: #B7791F] {
  id uuid [pk]
  membership_id uuid [ref: > community_memberships.id, note: '0019 dropped NOT NULL - a roster entry may be a typed name with no account']
  department_id uuid [ref: > departments.id]
  employment_type text [not null, default: 'staff', note: '0019 added the default; nothing on the form supplies one']
  designation text
  started_at date [not null]
  ended_at date
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  community_id uuid [note: '0019 - denormalised so the composite FK below can pin tenancy']
  display_name text [note: '0019 - carries the unlinked case']
  phone_e164 varchar(20) [note: '0019']
  job_title text [note: '0019 - the trade; separate from rank on purpose']
  rank text [not null, default: 'member', note: '0035 - manager | supervisor | member. Was head|member; `head` stays the WIRE word for the manager']
  shift text [note: '0035 - Day | Evening | Night | Full Day | Rotating']
  status text [not null, default: 'active', note: '0019 - active | inactive; removal deactivates, never deletes (A7)']
  service_provider_id uuid [ref: > service_providers.id, note: '0035 set it, 0042 made it readable - department_staff_overview predated the column by sixteen migrations and projected fourteen fields that did not include it, so every read returned a hired plumber and a typed-in name as the same shape. Only the write path used it, which is why it looked complete in every test']
  indexes {
    department_id [unique, note: '0035 - partial: rank = manager and status = active']
    (department_id, service_provider_id) [unique, note: '0035 - partial: status = active. A rehire is a second row, so the first keeps its history']
    (department_id, status)
    community_id
  }
  Note: 'The 0019 columns above were missing from this diagram until 2026-08-09. staff_assignments_identity_check requires membership_id or display_name, so a row is always nameable on screen. (department_id, community_id) is a composite FK onto departments(id, community_id), which makes a cross-tenant row unrepresentable rather than merely forbidden.'
}

Table skills [headercolor: #B7791F] {
  id uuid [pk]
  name text [not null, unique]
  category text
  description text
  is_active boolean [not null, default: true, note: '0034 - a retired trade is filtered, never deleted; a provider who has held it keeps the row that says so']
  created_at timestamptz [note: '0034']
  Note: 'GLOBAL, unlike complaint_categories which is per-community. That asymmetry is what complaint_categories.skill_id exists to bridge, and it is why service_provider_skills can be written before anyone has been hired. 12 trades seeded by 0034.'
}

// staff_skills was dropped by 0044 (superseded by service_provider_skills, D2:
// skills belong to the person, because the search that matters runs before
// anybody has hired them).

Table worker_availability_rules [headercolor: #B7791F] {
  id uuid [pk]
  staff_assignment_id uuid [ref: > staff_assignments.id, note: '0036 dropped NOT NULL - see the note below']
  service_provider_id uuid [ref: > service_providers.id, note: '0036 - the global side; exactly one of the two is set']
  weekday smallint [not null]
  start_time time [not null]
  end_time time [not null]
  effective_from date [not null]
  effective_to date
  Note: '0036 - num_nonnulls(staff_assignment_id, service_provider_id) = 1. A roster name with no account keeps per-department hours; a registered service person keeps ONE set across every community that has hired them, because their week is not a fact about one of their four societies. Both set has no defined meaning, which is the case the num_nonnulls spelling catches and the naive one misses. 0039 gave it endpoints: PUT /worker/availability-rules replaces the provider-keyed half whole, and the roster-keyed half stays writable by nobody, because the person it describes has no account.'
}

Table worker_unavailability [headercolor: #B7791F] {
  id uuid [pk]
  staff_assignment_id uuid [ref: > staff_assignments.id, note: '0036 dropped NOT NULL']
  service_provider_id uuid [ref: > service_providers.id, note: '0036 - leave is global across every community they serve']
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  reason text
  created_at timestamptz [not null, note: '0036']
  Note: '0036 - same one-subject rule as worker_availability_rules above. 0039 writes the provider-keyed half through POST /worker/unavailability. Overlapping rows are allowed on purpose: the dispatch sweep reads them with NOT EXISTS, so two blocks saying "away" say the same thing, and a uniqueness rule here would refuse "away all week, especially Tuesday".'
}

// Complaints and work
Table complaints [headercolor: #C53030] {
  id uuid [pk]
  community_id uuid [not null, ref: > communities.id]
  raised_by_membership_id uuid [not null, ref: > community_memberships.id]
  category text [not null]
  title text [not null]
  description text
  status complaint_status [not null, default: 'open']
  aggregate_version integer [not null, default: 1]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  resolved_at timestamptz

  department_id uuid [ref: > departments.id, note: '0019']
  assigned_to_membership_id uuid [ref: > community_memberships.id, note: '0019']
  assignee_label text [note: '0019 - staff without an account']
  due_at timestamptz [note: '0019 - the admin queue deadline']
  progress_percent integer [not null, default: 0, note: '0020']

  priority text [not null, default: 'low', note: '0031 - low/medium/high; the form calls it urgency']
  location text [note: '0031']
  expected_resolution_at timestamptz [note: '0031 - computed on insert from priority']
  reopened_count integer [not null, default: 0, note: '0031']
  resolution_rating smallint [note: '0031 - 1..5, set only by the resident']
  resident_feedback text [note: '0031']

  indexes {
    (department_id, status) [name: 'complaints_department_idx']
    (raised_by_membership_id, created_at) [name: 'complaints_raised_by_created_idx']
  }

  Note: '''
  RLS from 0031. Admins see the community queue, a resident sees their own:
  `is_community_admin(community_id) or is_own_membership(raised_by_membership_id)`.
  No write policy - raise_complaint, update_complaint, reopen_complaint and
  confirm_complaint_resolution are SECURITY DEFINER and authorize themselves.

  `resolved` and `closed` are not synonyms. The association resolves; only the
  resident closes, through confirm_complaint_resolution.

  The 0019 and 0020 columns above were missing from this diagram until 2026-08-04.
  They had been in the schema since those migrations; the omission was this file's.
  '''
}

Table complaint_events [headercolor: #C53030] {
  id uuid [pk]
  complaint_id uuid [not null, ref: > complaints.id]
  actor_membership_id uuid [ref: > community_memberships.id]
  actor_label text [note: '0020 - the name AT THE TIME of the event']
  event_type text [not null]
  payload jsonb [not null]
  created_at timestamptz [not null]

  Note: '''
  Append-only. Written only by the complaint RPCs, never directly.
  0031 adds `reopened` and `resolution_confirmed` to the event vocabulary.

  A `comment_added` event is written for internal comments too, because this
  timeline was built for the admin screen. The resident detail endpoint drops
  those rows: an entry saying something was said, leading to a thread where
  nothing new is visible, is a worse leak than the comment would have been.
  '''
}

Table complaint_comments [headercolor: #C53030] {
  id uuid [pk]
  complaint_id uuid [not null, ref: > complaints.id]
  author_membership_id uuid [ref: > community_memberships.id, note: '0020 made this nullable']
  author_label text [note: '0020']
  body text [not null]
  visibility text [not null, default: 'public', note: '0020 - public | internal']
  created_at timestamptz [not null]
}

Table complaint_read_state [headercolor: #C53030] {
  complaint_id uuid [pk, ref: > complaints.id]
  membership_id uuid [pk, ref: > community_memberships.id]
  last_read_at timestamptz [not null]

  Note: '''
  In the baseline from the start; nothing wrote to it until 0031.
  Per membership, so an admin opening a complaint cannot clear a resident marker.
  `complaint_overview.is_unread` is computed from it.
  '''
}

Table work_orders [headercolor: #C53030] {
  id uuid [pk]
  community_id uuid [not null, ref: > communities.id]
  complaint_id uuid [ref: > complaints.id]
  status text [not null, default: 'draft', note: '0036 - draft | awaiting_resident | offered | scheduled | in_progress | completed | failed | cancelled. Was default `open`, which is not in the set. The last three are declared and not yet reachable: they are the worker transitions and arrive with the worker portal']
  priority text [not null, default: 'medium', note: '0036 - low | medium | high, inherited from the complaint. Was default `normal` and unconstrained, while complaints.priority was already checked against these three -- two value sets for one name']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  department_id uuid [ref: > departments.id, note: '0036 - composite FK onto departments(id, community_id) ON DELETE CASCADE, so a cross-tenant job is unrepresentable. No second FK on this column: SET NULL would have nulled community_id too, which is NOT NULL']
  supervisor_membership_id uuid [ref: > community_memberships.id, note: '0036 - who triaged it; the address the resident answer is delivered to']
  skill_id uuid [ref: > skills.id, note: '0036 - derived from complaint_categories.skill_id when the caller omits it']
  scheduled_start_at timestamptz [note: '0036 - both ends or neither (work_orders_slot_check)']
  scheduled_end_at timestamptz
  subject_kind text [not null, default: 'resident', note: '0036 - resident | facility. Decides whether anybody is asked to confirm the time']
  location_text text
  latitude numeric(9,6) [note: '0036 - unused until the dispatcher measures against it']
  longitude numeric(9,6)
  failed_attempt_count smallint [not null, default: 0, note: '0036 - written by the worker portal, not by this migration']
  resident_deadline_at timestamptz [note: '0036 - when an unanswered proposal stops being worth waiting for']
  cancelled_reason text
  indexes {
    (department_id, status, scheduled_start_at) [note: '0036 - the supervisor queue']
    complaint_id
    resident_deadline_at [note: '0036 - partial: status = awaiting_resident. What 0037 will sweep']
  }
  Note: 'Un-parked from CONFLICT_RESOLUTIONS R16, which said to build nothing against this table. Extended additively rather than replaced, exactly as 0019 extended departments. ONE COMPLAINT MAY CARRY MANY: a failed visit is rescheduled and a reopened complaint goes to a different supervisor, and both are a second work order -- which is why the assignment is not columns on complaints, the smaller change that would have allowed only one scheduled visit per complaint. The lifecycle is written to complaint_events (job_created, job_scheduled, job_declined, job_assigned, job_cancelled) rather than to a parallel work_order_events table, and needed no migration because complaint_events.event_type is text with no CHECK.'
}

Table work_order_assignments [headercolor: #C53030] {
  id uuid [pk]
  work_order_id uuid [not null, ref: > work_orders.id]
  staff_assignment_id uuid [ref: > staff_assignments.id]
  assigned_at timestamptz [not null]
  ended_at timestamptz
  status text [not null, default: 'offered', note: '0036 - offered | accepted | declined | withdrawn | completed | failed. A supervisor assigning writes `accepted` directly; `offered` comes from 0037']
  offered_at timestamptz [not null]
  responded_at timestamptz
  decline_reason text
  is_auto_assigned boolean [not null, default: false, note: '0036 - always false until the dispatcher exists']
  scheduled_start_at timestamptz
  scheduled_end_at timestamptz
  indexes {
    (work_order_id, status)
    (staff_assignment_id, scheduled_start_at) [note: '0036 - partial: status = accepted. The worker calendar, in one index']
  }
  Note: 'CARRIES work_order_assignments_no_overlap: exclude using gist (staff_assignment_id with =, tstzrange(scheduled_start_at, scheduled_end_at, `[)`) with &&) where (status = accepted and scheduled_start_at is not null). A person cannot be in two places at once, and the schema is where that is said. Same construct amenity_bookings has carried since 0001, and it needs btree_gist -- which is not a new requirement, since 0001 both installs the extension and declares an exclusion constraint that cannot exist without it. THE PARTIAL PREDICATE IS THE INTERESTING HALF: only accepted rows are constrained, so 0037 may offer one slot to several workers and let exactly one take it.'
}

// Visitors, amenities, and finance
Table visitor_requests [headercolor: #6B46C1] {
  id uuid [pk]
  community_id uuid [not null, ref: > communities.id]
  requested_by_membership_id uuid [not null, ref: > community_memberships.id]
  visitor_name text [not null]
  visitor_phone_e164 varchar(20)
  status visitor_status [not null, default: 'expected']
  pass_hash text [unique]
  valid_from timestamptz
  valid_until timestamptz
  approved_by_membership_id uuid [ref: > community_memberships.id]
  checked_in_at timestamptz
  checked_out_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  // 0032 -- what the resident's pre-approval form collects, and the second
  // credential. `code_hash` is the short code they read aloud; `pass_hash` is
  // the QR token, and the two are separate artifacts stored the same way.
  //
  // Uniqueness on `code_hash` is a PARTIAL index on (community_id, code_hash)
  // over live passes only -- not the global unique the design sketch asked for.
  // Six digits is 900k values, so a project-wide unique index starts colliding
  // at a few hundred live passes and every collision is a cross-tenant write
  // failure. A code only has to be unambiguous at one gate among passes that
  // could currently open it.
  //
  // That holds only because something retires a lapsed pass. An index predicate
  // must be IMMUTABLE, so `live` there is a STATUS and not a time -- and the
  // baseline's `expired` status was written by nothing. `expire_visitor_passes`
  // settles a community's lapsed passes before each issue; without it the six
  // digits leak rather than recycle and the argument above is just a hope.
  purpose text
  purpose_details text
  guest_count integer [not null, default: 1]
  code_hash text
  decided_at timestamptz
  cancelled_at timestamptz
}

Table visitor_events [headercolor: #6B46C1] {
  id uuid [pk]
  visitor_request_id uuid [not null, ref: > visitor_requests.id]
  actor_membership_id uuid [ref: > community_memberships.id]
  event_type text [not null]
  created_at timestamptz [not null]
}

Table amenities [headercolor: #2F855A] {
  id uuid [pk]
  community_id uuid [not null, ref: > communities.id]
  name text [not null]
  description text
  booking_rules jsonb [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (community_id, name) [unique] }
}

Table amenity_operating_hours [headercolor: #2F855A] {
  id uuid [pk]
  amenity_id uuid [not null, ref: > amenities.id]
  weekday smallint [not null]
  opens_at time [not null]
  closes_at time [not null]
}

Table amenity_maintenance_blocks [headercolor: #2F855A] {
  id uuid [pk]
  amenity_id uuid [not null, ref: > amenities.id]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  reason text
}

Table amenity_bookings [headercolor: #2F855A] {
  id uuid [pk]
  amenity_id uuid [not null, ref: > amenities.id]
  community_id uuid [not null, ref: > communities.id]
  booked_by_membership_id uuid [not null, ref: > community_memberships.id]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  status booking_status [not null, default: 'requested']
  aggregate_version integer [not null, default: 1]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: 'The baseline uses a GiST exclusion constraint to prevent overlapping requested/approved times for an amenity.'
}

Table booking_charges [headercolor: #2F855A] {
  id uuid [pk]
  booking_id uuid [not null, ref: > amenity_bookings.id]
  amount numeric(12,2) [not null]
  kind text [not null]
  status text [not null, default: 'pending']
  created_at timestamptz [not null]
}

Table booking_refunds [headercolor: #2F855A] {
  id uuid [pk]
  booking_charge_id uuid [not null, ref: > booking_charges.id]
  amount numeric(12,2) [not null]
  reason text
  created_at timestamptz [not null]
}

Table invoices [headercolor: #2F855A] {
  id uuid [pk]
  community_id uuid [not null, ref: > communities.id]
  membership_id uuid [not null, ref: > community_memberships.id]
  status invoice_status [not null, default: 'draft']
  due_at timestamptz
  total_amount numeric(12,2) [not null, default: 0]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table invoice_line_items [headercolor: #2F855A] {
  id uuid [pk]
  invoice_id uuid [not null, ref: > invoices.id]
  description text [not null]
  amount numeric(12,2) [not null]
}

Table payments [headercolor: #2F855A] {
  id uuid [pk]
  community_id uuid [not null, ref: > communities.id]
  invoice_id uuid [ref: > invoices.id]
  provider text [not null, default: 'offline']
  provider_reference text
  amount numeric(12,2) [not null]
  status payment_status [not null, default: 'initiated']
  idempotency_key text
  created_at timestamptz [not null]

  // 0033 -- what a payment has to say when it FAILS. `record_payment` writes
  // `succeeded` and nothing else, because an admin only records money that
  // already arrived; a gateway declines, and "failed" alone is a row nobody can
  // act on.
  //
  // `failure_code` is a stable identifier and never prose -- `card_declined`,
  // not "Your card was declined." A CHECK enforces that it is null unless the
  // payment failed, because a decline reason on a succeeded payment is a
  // contradiction.
  //
  // `instrument_label` is a RECEIPT LINE and never a credential: `•••• 4242`,
  // `resident@upi`. No PAN, no CVV and no expiry is stored in this table or any
  // other -- they are read by a pure function in the API and discarded in the
  // same call.
  //
  // `provider` is the column that matters most here and it is not new. Resident
  // payments write 'simulator'; the admin's write 'offline'. On the day a real
  // gateway arrives, that string is the only thing that can separate the money
  // that moved from the money that did not.
  failure_code text
  instrument_label text
  indexes { (community_id, idempotency_key) [unique] }
}

Table payment_events [headercolor: #2F855A] {
  id uuid [pk]
  payment_id uuid [not null, ref: > payments.id]
  event_type text [not null]
  payload jsonb [not null]
  created_at timestamptz [not null]
}

// Communication, audit, and infrastructure
Table notices [headercolor: #2B6CB0] {
  id uuid [pk]
  community_id uuid [not null, ref: > communities.id]
  author_membership_id uuid [ref: > community_memberships.id]
  title text [not null]
  body text [not null]
  published_at timestamptz [note: 'null means DRAFT -- excluded from the resident view and by policy']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  // 0033 -- RLS, which this table also had none of. Members read published
  // notices; admins and managers read everything, because a draft is theirs and
  // the admin dashboard reads this table through the caller's own client.
  //
  // Still no `effective_at`. US-2.11 asks to be reminded BEFORE a rule takes
  // effect and there is no stored moment for a reminder to point at. One column,
  // and `notices` belongs to the admin workstream, so the story is theirs.
}

Table notifications [headercolor: #2B6CB0] {
  id uuid [pk]
  recipient_profile_id uuid [not null, ref: > profiles.id, note: '0041 — WHO it is for']
  recipient_membership_id uuid [ref: > community_memberships.id, note: '0041 made this nullable — it now says which community it was ABOUT']
  kind text [not null]
  payload jsonb [not null]
  read_at timestamptz
  created_at timestamptz [not null]
  push_sent_at timestamptz [note: '0030 — set when a sender CLAIMS the row, not when the push succeeds']
  push_attempts smallint [not null, default: 0, note: '0030']
  indexes {
    (recipient_profile_id, created_at) [note: '0041, desc — the feed read and the unread count']
    (recipient_membership_id, created_at) [note: '0030, desc — kept for the SSE trigger lookup']
    (created_at) [note: 'partial, where push_sent_at is null — the sender claim']
  }
  Note: 'The durable record. Every user-visible event writes a row here first; SSE and Web Push are two deliveries of it, never the record of it. Written only by notify_member() or notify_profile(), in the same transaction as the change it describes. 0041 re-addressed it from a membership to a PERSON: a service provider who has registered and not yet been hired holds no membership anywhere, so under the 0030 shape there was no row that could tell them the answer to their own application. recipient_profile_id is always populated, including for the membership case, so ownership has one predicate everywhere. RLS: read policy recipient_profile_id = auth.uid(), no write policy, so marking read is mark_notification_read(). A row with no membership gets no SSE frame -- sse_events.community_id is not null.'
}

Table push_subscriptions [headercolor: #718096] {
  id uuid [pk]
  profile_id uuid [not null, ref: > profiles.id, note: '0041 — was membership_id, which is dropped']
  endpoint text [not null, unique]
  p256dh_key text [not null]
  auth_key text [not null]
  user_agent text
  created_at timestamptz [not null]
  last_success_at timestamptz
  failure_count smallint [not null, default: 0]
  Note: 'One row per BROWSER, not per person: a phone and a laptop are two. endpoint is unique across the table because the endpoint URL is the browser identity to the push service, so a shared device re-subscribing moves the row instead of duplicating it. 0041 changed the owner from a membership to a profile, which fixed a defect the uniqueness had been hiding: a person in two societies subscribing the same browser from the second one MOVED the row and silently stopped the first society pushes. RLS enabled with no policy (service_role only) -- p256dh_key and auth_key are encryption material. register_push_subscription() takes no owner argument at all; it reads auth.uid().'
}

Table member_activity [headercolor: #2B6CB0] {
  id uuid [pk]
  community_id uuid [not null, ref: > communities.id]
  membership_id uuid [ref: > community_memberships.id]
  event_type text [not null]
  payload jsonb [not null]
  created_at timestamptz [not null]
}

Table audit_events [headercolor: #2B6CB0] {
  id uuid [pk]
  community_id uuid [ref: > communities.id]
  actor_membership_id uuid [ref: > community_memberships.id]
  action text [not null]
  payload jsonb [not null]
  created_at timestamptz [not null]
}

Table media [headercolor: #2B6CB0] {
  id uuid [pk]
  community_id uuid [not null, ref: > communities.id]
  storage_path text [not null, unique]
  mime_type text [not null]
  byte_size bigint [not null]
  uploaded_by_membership_id uuid [ref: > community_memberships.id]
  created_at timestamptz [not null]
  Note: 'Metadata only; object content is in external Supabase Storage.'
}

Table idempotency_records [headercolor: #718096] {
  community_id uuid [pk, ref: > communities.id]
  key text [pk]
  request_hash text [not null]
  response jsonb
  created_at timestamptz [not null]
}

Table rate_limit_buckets [headercolor: #718096] {
  bucket text [pk]
  count integer [not null, default: 0]
  window_ends_at timestamptz [not null]
}

Table sse_events [headercolor: #718096] {
  id bigint [pk]
  community_id uuid [not null, ref: > communities.id]
  topic text [not null]
  payload jsonb [not null]
  created_at timestamptz [not null]
  audience text [not null, default: 'community', note: '0028 — community | role | member']
  audience_roles "text[]" [note: '0028 — set iff audience = role']
  recipient_membership_id uuid [ref: > community_memberships.id, note: '0028 — set iff audience = member']
  indexes {
    (community_id, id)
    (recipient_membership_id, id) [note: '0028']
  }
  Note: 'Tenant-scoped live-update outbox, audience-scoped since 0028: a check constraint makes the three audiences mutually exclusive and complete, and the reader fails closed on anything it cannot classify. Browser clients consume the backend SSE projection, not database subscriptions. RLS enabled with no policy (0024), so only service_role reads it. EPHEMERAL — pruned every 15 minutes by prune_sse_events(), which is why nothing durable is built on it and notifications exists.'
}

// Deliberately separate to make the community/member circular relationship
// acceptable to dbdiagram.io.
Ref: communities.active_admin_membership_id > community_memberships.id

TableGroup identity_and_residency {
  auth.users
  profiles
  communities
  buildings
  units
  feature_catalog
  community_features
  community_memberships
  community_admin_terms
  unit_residencies
}

TableGroup joining_and_people {
  resident_invites
  access_requests
  departments
  staff_assignments
  skills
  worker_availability_rules
  worker_unavailability
}

TableGroup service_and_access {
  complaints
  complaint_events
  complaint_comments
  complaint_read_state
  work_orders
  work_order_assignments
  visitor_requests
  visitor_events
}

TableGroup amenities_and_finance {
  amenities
  amenity_operating_hours
  amenity_maintenance_blocks
  amenity_bookings
  booking_charges
  booking_refunds
  invoices
  invoice_line_items
  payments
  payment_events
}

TableGroup communication_and_platform {
  notices
  notifications
  push_subscriptions
  member_activity
  audit_events
  media
  idempotency_records
  rate_limit_buckets
  sse_events
}

// ===========================================================================
// ADMIN DASHBOARD — added by migrations 0018-0023
//
// Everything above is the clean baseline (0001). Everything below is what the
// admin dashboard backend adds on top of it, additively: seven new tables, and
// columns on nine existing ones. No baseline table is renamed or dropped.
//
// Three constraints the baseline declares are RELAXED rather than removed, each
// for a reason recorded in the migration that does it:
//   - staff_assignments.membership_id  -> nullable (rosters are typed names)
//   - complaint_comments.author_membership_id -> nullable (same reason)
//   - amenity_bookings.booked_by_membership_id -> nullable (maintenance blocks)
// ===========================================================================

Table community_settings [headercolor: #2C7A7B] {
  community_id uuid [pk, not null, ref: > communities.id]
  timezone text [not null, note: 'IANA name, validated against pg_timezone_names in the RPC']
  unit_label_singular text [note: 'Null means derive from communities.community_type']
  invite_ttl_hours integer [not null]
  visitor_code_ttl_minutes integer [not null]
  require_visitor_preapproval boolean [not null]
  notice_sms_broadcast_enabled boolean [not null]
  updated_by_membership_id uuid [ref: > community_memberships.id]
  version integer [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: 'Settings screen toggles 3 and 4. Read through community_settings_overview.'
}

Table community_billing_settings [headercolor: #2C7A7B] {
  community_id uuid [pk, not null, ref: > communities.id]
  currency_code char(3) [not null]
  invoice_number_prefix text [not null]
  default_maintenance_amount numeric(12,2) [note: 'Nullable: an unset rate must not be invented']
  maintenance_due_day smallint [not null, note: 'Capped at 28 so a due day never leaves February']
  default_tax_percent numeric(5,2) [not null]
  next_invoice_seq bigint [not null, note: 'Consumed under a row lock by issue_invoice; per community, not global']
  auto_billing_enabled boolean [not null]
  auto_billing_day smallint [not null]
  late_fee_enabled boolean [not null]
  late_fee_amount numeric(12,2)
  late_fee_grace_days smallint [not null]
  late_fee_period text [not null]
  version integer [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: 'Settings screen toggles 1 and 2 plus invoice numbering. Written by update_billing_settings.'
}

Table complaint_categories [headercolor: #B7791F] {
  id uuid [pk]
  community_id uuid [not null, ref: > communities.id]
  name text [not null]
  created_at timestamptz [not null]
  Note: 'UQ (community_id, lower(btrim(name))) — categories are typed as free text, so Plumbing and plumbing are one category.'
}

Table department_categories [headercolor: #B7791F] {
  department_id uuid [pk, not null, ref: > departments.id]
  category_id uuid [pk, not null, ref: > complaint_categories.id]
  created_at timestamptz [not null]
  Note: 'Which complaint categories a department claims. The baseline has no equivalent.'
}

Table amenity_booking_guests [headercolor: #6B46C1] {
  id uuid [pk]
  community_id uuid [not null, ref: > communities.id]
  booking_series_id uuid [not null, note: 'The booking group id; no FK, because there is no group entity']
  guest_name text [not null]
  phone_e164 varchar(20)
  created_at timestamptz [not null]
  Note: 'Guests named on a booking. No membership reference: a guest is by definition not a member.'
}

Table amenity_booking_charges [headercolor: #6B46C1] {
  id uuid [pk]
  community_id uuid [not null, ref: > communities.id]
  booking_occurrence_id uuid [not null, ref: > amenity_bookings.id]
  charge_type text [not null, note: 'booking_fee | deposit | damage_deposit | late_cancellation | additional']
  label text
  amount numeric(12,2) [not null]
  created_at timestamptz [not null]
  Note: 'Per-booking charge breakdown. The baseline booking_charges is written alongside it and kept populated.'
}

Table amenity_financial_events [headercolor: #6B46C1] {
  id uuid [pk]
  community_id uuid [not null, ref: > communities.id]
  booking_charge_id uuid [not null, ref: > amenity_booking_charges.id]
  event_type text [not null, note: 'payment | refund | damage_deduction | charge | payment_failed (0033). The fifth was added because the first four had no word for "this did not go through": a decline written as a charge puts a phantom line in the ledger, and written as a payment it shows the booking as paid. Every aggregate in amenity_ledger_overview filters on this column, so the new type counts towards nothing.']
  amount numeric(12,2) [not null]
  payment_reference text [note: 'UQ (community_id, event_type, payment_reference) — makes record_amenity_payment idempotent']
  reason text
  notes text
  instrument_label text [note: 'Masked receipt line — 0033. NEVER a PAN, a CVV or an expiry. Added because a replayed idempotency key must be answered from the row that recorded the attempt, and a row that never stored what was paid with cannot describe it.']
  actor_membership_id uuid [ref: > community_memberships.id]
  created_at timestamptz [not null]
  Note: 'Append-only. Money moves against a CHARGE, not a booking, so a refund can say which deposit it returned.'
}

TableGroup admin_dashboard {
  community_settings
  community_billing_settings
  complaint_categories
  department_categories
  amenity_booking_guests
  amenity_booking_charges
  amenity_financial_events
}

// ---------------------------------------------------------------------------
// COLUMNS ADDED TO BASELINE TABLES
//
// Listed here rather than edited into the table blocks above, so this file
// stays mergeable with whatever the baseline does next. Full definitions and
// the reasoning are in the migration named against each group.
//
//   departments          (0019) contact_email, contact_phone_e164, opens_at,
//                               closes_at, sla_hours, kind, status
//                               status <-> is_active kept equal by a trigger,
//                               because their dashboard reads is_active.
//   staff_assignments    (0019) community_id, display_name, phone_e164,
//                               job_title, rank, shift, status
//   complaints           (0019) department_id, assigned_to_membership_id,
//                               assignee_label, due_at
//                        (0020) progress_percent
//   complaint_events     (0020) actor_label
//   complaint_comments   (0020) author_label, visibility
//   invoices             (0021) unit_id, invoice_number, invoice_type, title,
//                               billing_period_start, billing_period_end,
//                               issued_on, due_on, subtotal_amount, tax_amount,
//                               currency_code, notes
//   invoice_line_items   (0021) community_id, quantity, unit_amount, sort_order,
//                               total_amount (GENERATED from quantity x unit_amount)
//   payments             (0021) currency_code, payment_method, paid_at, notes,
//                               payer_profile_id, received_by_membership_id
//   feature_catalog      (0022) sort_order, backend_status, backend_note
//   amenities            (0023) 30 configuration columns; booking_rules jsonb
//                               is left untouched for their readers
//   amenity_bookings     (0023) booking_group_id, unit_id, title, booking_type,
//                               source, is_private, is_exclusive, guest_count,
//                               occupant_count, notes, department,
//                               charge_override, buffer_minutes, requested_at,
//                               approved_at, rejected_at, rejection_reason,
//                               rejection_reason_code, cancelled_at,
//                               cancellation_reason, cancellation_reason_code,
//                               cancelled_by_resident, force_cancelled
//
// VIEWS (all security_invoker, so RLS still applies to the caller)
//
//   department_overview, department_staff_overview        (0019)
//   invoice_overview, payment_overview                    (0021)
//   community_settings_overview, community_module_overview (0022)
//   amenity_overview, amenity_booking_overview,
//   amenity_ledger_overview, amenity_ledger_summary       (0023)
//   pending_access_request_overview                       (0024)
//   bookable_amenity                                      (0029)
//   notification_overview                                 (0030)
//   complaint_overview                                    (0031)
//   visitor_pass_overview                                 (0032)
//
// complaint_overview is the RESIDENT's projection of a complaint. It computes
// three things the API would otherwise have to: is_overdue (the same predicate
// department_overview uses for its overdue count, so the two screens cannot
// disagree about one complaint), comment_count and last_activity_at (so a list
// is one query rather than one plus N), and is_unread -- which is per-caller and
// therefore could never have been a column on the row. Per-caller means the
// read_state join matches the CALLER's rows, not the raiser's: mark_complaint_read
// writes one row per membership so an admin cannot clear a resident's marker, and
// a view keyed to the raiser would ignore every row it wrote for anyone else.
//
// visitor_pass_overview is the RESIDENT's projection of a visitor pass, and the
// notable thing about it is a column list that stops short: NEITHER hash is
// selected. Not because a hash is dangerous to display -- it is not -- but
// because a column that never leaves the database cannot be leaked by a later
// `select *`, and no reader on that surface has any use for one. It also
// computes is_current, which is what splits the resident's two tabs, so the
// split cannot drift from the transitions decide_visitor_pass allows.
//
// bookable_amenity is the RESIDENT's projection of amenities -- the resident
// column list, filtered to active amenities with no temporary closure. Two
// views over one table, each owned by the surface that reads it: sharing
// amenity_overview would leave the resident payload one column away from an
// admin field the moment one was added for the admin card.
//
// pending_access_request_overview backs DashboardSnapshot.pendingRequests --
// the field the admin sidebar badge counts. No new table: it is a projection of
// access_requests where status = 'pending', joined to communities and units.
//
// REALTIME (0024)
//
//   emit_access_request_sse_event() adds access_request.created and
//   access_request.decided topics to the existing sse_events outbox, alongside
//   the generic dashboard.refresh that 0007 already emits from 12 tables.
//   Both carry the live pending count so a badge can update from the event.
//   See the "Live updates" section of docs/ARCHITECTURE.md.
//
// NOTIFICATIONS AND PUSH (0028, 0030)
//
//   0028 gives every outbox row an audience, so one stream serves every role
//   without a resident receiving admin traffic.
//   0030 makes notifications the durable record: notify_member() writes it in
//   the causing transaction, a trigger emits one member-addressed sse_events
//   row from it, and claim_push_batch() leases un-pushed rows with
//   `for update skip locked` so two sender processes cannot buzz one phone
//   twice. push_subscriptions holds the browsers. See
//   docs/design/RESIDENT_BACKEND_DESIGN.md 10.
//
// community_module_overview reads feature_catalog + community_features, NOT
// module tables of ours. That is conflict C-11 closed: there is exactly one
// place a module's enabled state lives, and onboarding owns the writer.
// ---------------------------------------------------------------------------

// ===========================================================================
// SERVICE OPERATIONS (0034, 0035)
//
// The first entity in this model that exists BEFORE and INDEPENDENTLY of any
// community. Everything above describes somebody already inside one -- a
// resident with a unit, an admin with a term, a staff member whose whole
// existence is a row on one department's roster. A service person registers
// themselves, is hired by communities afterwards, and goes on existing when
// every one of them drops them.
//
// That overturns docs/product/USER_IDENTIFICATION.md's rule that a staff
// member is "a name on a roster, not an account". It stays true for a roster
// name typed into the departments form; it stops being the only case.
// ===========================================================================

Table service_providers [headercolor: #2C7A7B] {
  id uuid [pk]
  profile_id uuid [not null, unique, ref: > profiles.id]
  display_name text [not null]
  headline text
  bio text
  phone_e164 varchar(20)
  latitude "numeric(9,6)"
  longitude "numeric(9,6)"
  location geography [note: '0034 - generated from lat/lng, GiST indexed; lat/lng are the stored truth']
  service_radius_km "numeric(6,2)" [not null, default: 15]
  status text [not null, default: 'active', note: '0034 - active | paused | suspended']
  is_available boolean [not null, default: true, note: '0034 - the dashboard offline toggle; distinct from status']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: 'A service person, global. Created by the holder of the profile, never by an administrator.'
}

Table service_provider_skills [headercolor: #2C7A7B] {
  service_provider_id uuid [pk, ref: > service_providers.id]
  skill_id uuid [pk, ref: > skills.id]
  proficiency_level smallint
  created_at timestamptz [not null]
  Note: 'Skills belong to the PERSON, not to a roster row. The "which communities need my trades" search has to run before anyone has hired them, which is exactly when they have no staff_assignment to hang a skill on. Supersedes staff_skills.'
}

Table blacklisted_service_providers [headercolor: #2C7A7B] {
  id uuid [pk]
  community_id uuid [not null, ref: > communities.id]
  service_provider_id uuid [not null, ref: > service_providers.id]
  blacklisted_by_membership_id uuid [not null, ref: > community_memberships.id]
  reason text [not null]
  created_at timestamptz [not null]
  revoked_at timestamptz
  revoked_by_membership_id uuid [ref: > community_memberships.id]
  indexes { (community_id, service_provider_id) [unique, note: 'Partial: revoked_at is null'] }
  Note: 'Deliberately NOT blacklisted_residents. That table is keyed on a profile and enforced inside search_joinable_communities, so reusing it would bar this person from LIVING here as a side effect of refusing to hire them.'
}

Table staff_departures [headercolor: #2C7A7B] {
  id uuid [pk]
  community_id uuid [not null, ref: > communities.id]
  department_id uuid [not null, ref: > departments.id]
  staff_assignment_id uuid [not null, ref: > staff_assignments.id]
  service_provider_id uuid [ref: > service_providers.id]
  initiated_by text [not null, default: 'worker', note: '0043 - worker | manager. Their OWN roster row makes it a resignation even when that person also manages the department']
  requested_by_membership_id uuid [ref: > community_memberships.id]
  reason text
  status text [not null, default: 'pending', note: '0043 - pending | approved | rejected | cancelled. There is deliberately no handover state: that is pending with a non-zero outstanding count, and a status derived from a count is a status that can disagree with it']
  requested_effective_at timestamptz [note: '0045 - when the worker wants to stop. Null means immediately']
  effective_at timestamptz [note: '0045 - when the manager decided they stop. Stamped at approval; the departure_removal timekeeper fires on it. Approval releases booked work from this moment to the pool at queue priority 1 - the 2026-08-10 ruling that overturned 0043 zero-commitment gate on Approve']
  decided_by_membership_id uuid [ref: > community_memberships.id]
  decided_at timestamptz
  decision_note text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes {
    (staff_assignment_id) [unique, note: 'Partial: status = pending. One open departure per roster row']
    (department_id, status, created_at)
  }
  Note: 'A request to leave, and the handover the approval is gated on. Before 0043 removal was one statement that said nothing about the work the person was holding -- an accepted work_order_assignments row survived a removal untouched, still pointing at tomorrow, addressed to a membership that had just ended. A pending row here freezes the dispatch sweep against that staff row and two triggers refuse any new booking against it, so the outstanding list can only get shorter. Approval is refused while it is non-empty; a BAR is the exception and releases the work to the engine instead.'
}

Table service_applications [headercolor: #2C7A7B] {
  id uuid [pk]
  community_id uuid [not null, ref: > communities.id]
  department_id uuid [not null, ref: > departments.id]
  service_provider_id uuid [not null, ref: > service_providers.id]
  direction text [not null, note: '0035 - applied | invited. Who opened it, and therefore who may NOT decide it']
  status text [not null, default: 'pending', note: '0035 - pending | accepted | rejected | withdrawn | expired']
  message text
  rank text [note: '0035 - the terms on offer: manager | supervisor | member']
  job_title text
  shift text
  created_by_membership_id uuid [ref: > community_memberships.id]
  decided_by_membership_id uuid [ref: > community_memberships.id]
  decided_at timestamptz
  decision_note text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes {
    (department_id, service_provider_id) [unique, note: 'Partial: status = pending. One open negotiation per pair']
    (department_id, status, created_at)
    (service_provider_id, status, created_at)
  }
  Note: 'An application and an invitation are one negotiation started from opposite ends, so they are one table. Accepting does the same three writes either way -- membership, staff_assignments row, decision -- in ONE transaction. Two tables would mean two inboxes and two chances for a hire to be half-done.'
}

// ---------------------------------------------------------------------------
// WHAT 0035 CHANGED ON THE TABLES ABOVE
//
//   staff_assignments.rank      head|member -> manager|supervisor|member.
//     Four vocabularies disagreed; this is the ERD's, minus the part that
//     duplicated departments.kind. `head` remains the WIRE word for the person
//     holding rank = manager, so the admin screen is untouched.
//     staff_assignments_one_active_head is renamed to ..._one_active_manager,
//     and apply_department_head -- the only function in this schema that ever
//     sets a rank -- is rewritten with it.
//
//   staff_assignments.shift     Morning|Evening|Night|Full Day
//                            -> Day|Evening|Night|Full Day|Rotating.
//     Python validated Day|Evening|Night, so three of five words failed on one
//     side or the other and only Evening and Night could be saved at all.
//
//   departments.kind            internal|vendor|hybrid -> service|security.
//     Nothing wrote the old set; Python and API.md both said the new one. The
//     two did not intersect, so every department write naming a kind was a
//     23514. `kind` is now load-bearing: it decides whether an accepted
//     application issues a `worker` membership or a `security` one.
//
//   staff_assignments.service_provider_id -> service_providers.id.
//     Three populations now share the roster, told apart by which columns are
//     null: a typed name (both null), a hired service person (both set), and
//     an existing member given a department role (membership only).
//
//   complaint_categories.skill_id -> skills.id, filled by a name-matching
//     trigger. The ONLY join between what a person can do and what a community
//     needs done. A community whose category matches no catalogue trade simply
//     matches no service person, which is not an error.
//
//   communities.latitude / longitude / location, mirroring service_providers.
//
//   skills.is_active -- a retired trade is filtered, never deleted, so a
//     provider who has held it for two years keeps the row that says so.
//
// VIEWS: service_provider_overview, service_application_overview,
//   service_engagement_overview. FUNCTIONS: search_serviceable_communities
//   (the provider's side) and search_hireable_service_providers (the
//   department's), which are the same three rules seen from opposite ends.
//
// staff_skills and vendors were superseded and are now dropped by 0044
// (2026-08-10). See docs/CONFLICT_RESOLUTIONS.md R16's amendment.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// 0038 - THE HIRING CONVERSATION
// ---------------------------------------------------------------------------

Table conversations [headercolor: #2C7A7B] {
  id uuid [pk]
  community_id uuid [not null, ref: > communities.id, note: '0038 - denormalised from the department so the read policy can call is_community_admin without a join']
  department_id uuid [not null, ref: > departments.id, note: '0038 - also half of a composite FK onto departments(id, community_id), added 2026-08-10. The denormalised community_id above is only trustworthy if something enforces the pair']
  service_provider_id uuid [not null, ref: > service_providers.id]
  created_at timestamptz [not null]
  last_message_at timestamptz [note: '0038 - stamped by post_conversation_message, not by a trigger. Read policies only, so there is no second writer to defend against']
  indexes {
    (department_id, service_provider_id) [unique, name: 'conversations_one_per_pair', note: 'ONE thread per pair, forever. This is what lets open_conversation be an upsert rather than a read-then-write']
    (service_provider_id, last_message_at)
    (department_id, last_message_at)
  }
  Note: 'One thread per (department, provider) pair. The thread outlives every application in it -- somebody who applied, was rejected, and applied again a year later is talking to the same department about the same work -- so it is keyed to the pair and has no foreign key to service_applications. There is deliberately NO conversation_participants table: participation is derivable (an admin or manager of the department, or that provider) and deriving it is exactly what the RLS policy computes.'
}

Table conversation_messages [headercolor: #2C7A7B] {
  id uuid [pk]
  conversation_id uuid [not null, ref: > conversations.id]
  author_membership_id uuid [ref: > community_memberships.id, note: '0038 - the department side']
  author_provider_id uuid [ref: > service_providers.id, note: '0038 - the provider side']
  body text [not null, note: '0038 - length(btrim(body)) between 1 and 4000']
  created_at timestamptz [not null]
  indexes {
    (conversation_id, created_at)
  }
  Note: 'TWO author columns, exactly one set (num_nonnulls = 1). Not one column, because the provider a manager most needs to reach is one who has NOT been hired yet and therefore holds no membership in this community at all -- the same fact that makes an invitation unnotifiable. Which column is written is decided by the THREAD rather than by the caller, so author_provider_id is not null reads as "the worker said this" even after they are hired and hold a membership too.'
}

// VIEWS: conversation_overview (thread list, both counterparts named, last line
//   and message count) and conversation_message_overview (author resolved to a
//   name and a side). FUNCTIONS: is_conversation_participant -- ONE definition,
//   called by both read policies and both write RPCs -- plus open_conversation
//   (upsert) and post_conversation_message.
//
// No read receipts and no unread counts: nothing in the requirement asks for
// them, and adding one later is a lateral join on created_at.

// ---------------------------------------------------------------------------
// 0046 - direct messages. Person-to-person chat for the dock on every portal.
// NOT an extension of conversations: that schema is structurally a
// department<->provider channel (NOT NULL provider, one-of-two author check).
// ---------------------------------------------------------------------------

Table dm_threads [headercolor: #2C7A7B] {
  id uuid [pk]
  community_id uuid [not null, ref: > communities.id]
  kind text [not null, default: 'direct', note: '0046 - direct | work_order. (kind = work_order) = (work_order_id is not null)']
  work_order_id uuid [ref: > work_orders.id, note: '0046 - the job a worker<->resident thread is about']
  participant_a_profile_id uuid [not null, ref: > profiles.id]
  participant_b_profile_id uuid [not null, ref: > profiles.id, note: '0046 - CHECK a < b: canonical order makes the pair a value, so (a,b) and (b,a) cannot be two threads']
  participant_a_name text [not null, note: '0046 - a SNAPSHOT, refreshed on re-open. profiles is readable only by its owner (profiles_self, 0001), so a view joining it would show every counterpart as null. Same trade as staff_assignments.display_name, same known cost']
  participant_b_name text [not null]
  locked_at timestamptz [note: '0046 - stamped by a trigger when the work order goes terminal. A locked thread stays READABLE and refuses writes with HB409: the PO protection against a serviceman keeping a private line to a resident after the work is done, and the documented-history half of the same ruling']
  last_message_at timestamptz
  created_at timestamptz [not null]
  indexes {
    (community_id, participant_a_profile_id, participant_b_profile_id) [unique, note: '0046 - partial: kind = direct. One thread per pair per community; opening is an upsert']
    (work_order_id) [unique, note: '0046 - partial: kind = work_order and locked_at is null. One LIVE thread per job; a locked one is history and does not block the next accepted worker']
  }
  Note: 'Who may reach whom is dm_pair_allowed, one predicate behind both the recipients directory and the open: both active members, and either one is an admin or manager -- THE COMMITTEE IS THE ADMIN ROLE (USER_IDENTIFICATION.md) -- or they share a department. Residents reach the office, not each other; their worker contact is the job thread.'
}

Table dm_messages [headercolor: #2C7A7B] {
  id uuid [pk]
  thread_id uuid [not null, ref: > dm_threads.id]
  author_profile_id uuid [ref: > profiles.id, note: '0046 - NULL is a system line ("the job ended, this conversation is closed"), written only by definer functions. The receipt-only case the PO named']
  body text [not null, note: '0046 - length(btrim(body)) between 1 and 4000']
  created_at timestamptz [not null]
  indexes {
    (thread_id, created_at)
  }
}
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// 0037 — THE DISPATCH ENGINE
//
// One table. Everything else in 0037 is functions and a trigger, which a
// diagram of tables cannot show and which is where the whole design lives --
// see docs/API.md 18 and docs/plans/SERVICE_OPERATIONS_PROGRESS.md 6.6.
// ---------------------------------------------------------------------------

Table dispatch_tasks [headercolor: #B7791F] {
  id uuid [pk]
  work_order_id uuid [ref: > work_orders.id, note: '0037 - on delete cascade. 0045 dropped NOT NULL: a timer now belongs to a work order XOR a departure (num_nonnulls check)']
  departure_id uuid [ref: > staff_departures.id, note: '0045 - the timekeeper subject. An approved dated departure carries one departure_removal timer that releases whatever is still booked and removes the person at the effective date']
  kind text [not null, note: '0037 - ping | auto_assign | resident_timeout | failed_visit_escalation; 0045 added departure_removal as the fifth, collecting on the 0037 promise that a new kind touches no Python']
  priority smallint [not null, default: 0, note: '0045 - claim order: 2 = urgent auto-assign, 1 = departure-released work ("just below urgent", the PO phrase implemented literally), 0 = everything else']
  due_at timestamptz [not null, note: '0037 - when the dispatcher should act. The engine holds no timers in memory; this column IS the schedule']
  attempts smallint [not null, note: '0037 - incremented on claim, not on failure. Five and the task retires itself']
  claimed_at timestamptz [note: '0037 - LEASE START, not a completion mark. Open five minutes after this and it is claimable again']
  completed_at timestamptz
  last_error text [note: '0037 - why it did not fire, for a human. Cleared on a successful run']
  created_at timestamptz [not null]
  indexes {
    (work_order_id, kind) [unique, name: 'dispatch_tasks_one_open_per_kind', note: '0037 - partial: completed_at is null. This is the index the enqueue upserts onto, so a job rescheduled three times carries ONE live timer pointing at the newest deadline']
    (departure_id, kind) [unique, name: 'dispatch_tasks_one_open_per_departure_kind', note: '0045 - the same rule for the timekeeper: a re-approval with a new date moves the one timer']
    (priority, due_at) [note: '0045 - partial: completed_at is null. The claim query orders priority desc, due_at']
  }
  Note: 'The engine at-LEAST-once, which is the opposite of what the push sender chose. push.py claims by marking a notification sent before it sends, so a crash loses a buzz rather than repeating one -- right for something that vibrates a phone at 3am, wrong here, because a dropped resident_timeout is a complaint left waiting forever with nobody coming. So claim_dispatch_batch takes a lease and every firing function is idempotent: each re-reads the work order and returns without writing if the world has already moved on. RLS is ENABLED WITH NO POLICY, following push_subscriptions (0030): machine bookkeeping, no client has a reason to read it, and the dispatcher runs on the service client which bypasses RLS. Rows are written by exactly one thing -- an after-insert-or-update trigger on work_orders that keeps this table in agreement with the job status -- so no future write path has to remember to arm a timer, and cancelling a job stops its timers without cancel_work_order knowing this table exists.'
}
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// 0040 - security operations. The gate: where a guard stands, who is standing
// there, the two registers that replace paper, incidents, and the audit trail
// that makes an unsigned offline bundle safe.
//
// This is the third department kind finally getting its own work. Hiring,
// skills, availability, the calendar, blacklisting and messaging are all reused
// from 0034-0039 verbatim -- a guard is hired by exactly the RPC that hires a
// plumber -- because the only thing that differs is what the work IS. A shift
// is a post occupied for a window, not a job dispatched to an address.
//
// Closes US-3.3, US-3.4 and US-3.6, and finishes US-3.1 by finally reading
// visitor_requests.guest_count, a column 0032 added and nothing ever used.
// See docs/API.md 19 and docs/plans/SERVICE_OPERATIONS_PROGRESS.md 6.8.
// ---------------------------------------------------------------------------

Table security_posts [headercolor: #2C7A7B] {
  id uuid [pk]
  community_id uuid [not null, ref: > communities.id]
  department_id uuid [ref: > departments.id, note: '0040 - composite FK on (department_id, community_id) ON DELETE CASCADE, the house cross-tenant guard. Cascade rather than set null for the reason 4.14 had to learn on work_orders: a composite SET NULL nulls EVERY column in the pair, and community_id is not null']
  name text [not null]
  location_text text
  latitude "numeric(9,6)"
  longitude "numeric(9,6)"
  is_active boolean [not null, note: '0040 - deactivated, never deleted. A post that is gone still names the place a register entry was recorded two years ago, and US-3.6 is a story about reading records that old']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes {
    (community_id, name) [unique, name: 'security_posts_live_name_idx', note: '0040 - partial: is_active, on lower(btrim(name)). Main Gate and main gate are one place']
  }
  Note: 'Where a guard stands. Written only by upsert_security_post, which requires gate_admin_community_for -- an admin, a manager, or a security membership whose roster row is ranked manager or supervisor. That last clause is the first place D3s rank-and-role split has to be honoured in code rather than described.'
}

Table security_shifts [headercolor: #2C7A7B] {
  id uuid [pk]
  community_id uuid [not null, ref: > communities.id]
  department_id uuid [ref: > departments.id, note: '0040 - composite FK on (department_id, community_id) ON DELETE CASCADE. Derived from the roster row rather than accepted from the caller']
  post_id uuid [ref: > security_posts.id, note: '0040 - on delete set null. A deleted post does not erase the record that somebody worked that night']
  staff_assignment_id uuid [not null, ref: > staff_assignments.id]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  status text [not null, note: '0040 - scheduled | active | completed | cancelled | missed']
  notes text
  created_by_membership_id uuid [ref: > community_memberships.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes {
    (staff_assignment_id, starts_at) [name: 'security_shifts_no_overlap', note: '0040 - really an EXCLUDE USING gist over staff_assignment_id WITH = and tstzrange(starts_at, ends_at) WITH overlap, WHERE status is not cancelled. Rendered as an index here because dbml has no exclusion-constraint syntax']
    (community_id, starts_at) [name: 'security_shifts_community_window_idx']
  }
  Note: 'work_order_assignments with the nouns changed -- same GiST exclusion constraint, same btree_gist dependency, same reason: a person cannot be in two places at once, and the schema is where that is said. THE PARTIAL PREDICATE IS WHERE THE TWO DIFFER AND IT HAS TO. Assignments constrain only accepted rows, because the dispatcher offers one slot to five workers and exactly one takes it -- constrain the offers and it can only ever ask one person. Nobody offers a shift to five guards, so there is no equivalent state and the predicate is everything except cancelled: a COMPLETED shift still occupied that evening, and a new one written over it is a rota error rather than a historical curiosity. Overlap is refused BY NAME in schedule_security_shift before the constraint refuses it by number, the pairing 4.13 arrived at.'
}

Table material_movements [headercolor: #2C7A7B] {
  id uuid [pk]
  community_id uuid [not null, ref: > communities.id]
  direction text [not null, note: '0040 - inward | outward']
  description text [not null]
  quantity "numeric(12,2)"
  unit text
  is_returnable boolean [not null]
  expected_return_at timestamptz [note: '0040 - CHECK: null unless is_returnable. A return date on a non-returnable item is a contradiction that would produce a still-out report quietly disagreeing with itself']
  returned_at timestamptz [note: '0040 - same CHECK. Set by mark_material_returned, which is idempotent: the second guard to press returned is telling the truth and the row already says so']
  carrier_name text
  vehicle_number text
  unit_id uuid [ref: > units.id, note: '0040 - on delete set null. Which flat the material was for, when anybody knows']
  post_id uuid [ref: > security_posts.id]
  notes text
  recorded_by_membership_id uuid [ref: > community_memberships.id]
  recorded_at timestamptz [not null]
  source_client_id text [note: '0040 - the id the GATE DEVICE generated, unique per community. A queued offline entry replayed twice is one row, and the RPC returns the original id rather than raising -- a device coming back online wants the id it would have had, not a conflict']
  created_at timestamptz [not null]
  indexes {
    (community_id, source_client_id) [unique, name: 'material_movements_source_client_idx', note: '0040 - partial: source_client_id is not null']
    (community_id, expected_return_at) [name: 'material_movements_outstanding_idx', note: '0040 - partial: is_returnable and returned_at is null. The still-out report the returnable column exists for']
    (community_id, recorded_at) [name: 'material_movements_community_recorded_idx']
  }
  Note: 'US-3.3, replacing the paper register. A SEPARATE TABLE from water_tanker_logs rather than one typed table with a kind and a details jsonb (plan D12) -- and the reading confirms it: the two share not one column past the bookkeeping. is_returnable, expected_return_at and returned_at against tanker_number, volume_litres and supplier_name. One table would be null-heavy in both halves and would move validation out of the schema and into Python.'
}

Table water_tanker_logs [headercolor: #2C7A7B] {
  id uuid [pk]
  community_id uuid [not null, ref: > communities.id]
  supplier_name text
  tanker_number text [not null, note: '0040 - stored UPPER-cased by the RPC. A plate written down by two guards on two shifts is one vehicle, and a report that splits it into two is the report nobody trusts']
  volume_litres integer
  driver_name text
  driver_phone_e164 "varchar(20)"
  arrived_at timestamptz [not null]
  departed_at timestamptz [note: '0040 - CHECK: null, or at or after arrived_at. Recorded by a later PATCH; an auditable record needs both ends of the visit']
  post_id uuid [ref: > security_posts.id]
  notes text
  recorded_by_membership_id uuid [ref: > community_memberships.id]
  source_client_id text [note: '0040 - same idempotency key as the material register']
  created_at timestamptz [not null]
  indexes {
    (community_id, source_client_id) [unique, name: 'water_tanker_logs_source_client_idx', note: '0040 - partial: source_client_id is not null']
    (community_id, arrived_at) [name: 'water_tanker_logs_community_arrived_idx']
  }
  Note: 'US-3.4, and the first thing in this product that touches water management at all.'
}

Table security_incidents [headercolor: #2C7A7B] {
  id uuid [pk]
  community_id uuid [not null, ref: > communities.id]
  category text [not null, note: '0040 - security_concern, medical_emergency, fire_alarm, unauthorised_access, property_damage or other. Snake case stored, the frontends five display strings on the wire, mapped in app/domain/vocabularies.py -- the seam 5.8 and 4.6 both used. other is in the set on purpose: a closed vocabulary with no escape hatch is a form people work around by picking the nearest wrong option']
  severity text [not null, note: '0040 - low, medium, high or critical. THE ONLY FIELD IN THIS SCHEMA WHOSE VALUE DECIDES WHETHER SOMETHING NOTIFIES: high and critical reach the communitys admins and managers, low and medium are a record. Everywhere else that decision is made by the operations identity']
  status text [not null, note: '0040 - open, acknowledged or resolved']
  summary text [not null]
  details text
  location_text text
  post_id uuid [ref: > security_posts.id]
  occurred_at timestamptz [not null]
  resolved_at timestamptz [note: '0040 - cleared when the status moves back off resolved, so the timestamp never outlives the status that justified it']
  reported_by_membership_id uuid [ref: > community_memberships.id]
  source_client_id text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes {
    (community_id, source_client_id) [unique, name: 'security_incidents_source_client_idx', note: '0040 - partial: source_client_id is not null']
    (community_id, occurred_at) [name: 'security_incidents_community_occurred_idx']
  }
  Note: 'The form already exists and already writes to nothing. SecurityDashboard.jsx:166 collects a type, a location and details, and logIncident appends an interpolated STRING to an in-memory activity feed -- the same defect DECISIONS_NEEDED B2 names on the complaint assignee, one surface over. This is the table that string should always have gone into.'
}

Table offline_reconcile_log [headercolor: #2C7A7B] {
  id uuid [pk]
  community_id uuid [not null, ref: > communities.id]
  source_client_id text [not null, note: '0040 - unique per community. THE IDEMPOTENCY KEY, and the reason this table exists at all']
  credential_hash text
  claimed_at timestamptz [not null, note: '0040 - when the DEVICE says the credential was presented. verify_gate_credential is re-run against this instant, not against now()']
  claimed_verdict text [note: '0040 - what the device decided at the time']
  server_verdict text [not null, note: '0040 - what the server decides on replay. The pair is the point: an entry the server would have refused is neither silently dropped nor silently accepted -- it is a row somebody can be asked about']
  visitor_request_id uuid [ref: > visitor_requests.id]
  detail text
  submitted_by_membership_id uuid [ref: > community_memberships.id]
  submitted_at timestamptz [not null]
  indexes {
    (community_id, source_client_id) [unique, name: 'offline_reconcile_log_source_client_idx']
    (community_id, submitted_at) [name: 'offline_reconcile_log_community_idx']
  }
  Note: 'WHY THE OFFLINE BUNDLE IS NOT SIGNED, WHICH PLAN D13 SAID IT WOULD BE. A signature the device verifies against a key the device holds is theatre -- the same person who can edit localStorage can delete the check beside it, because both are JavaScript on their machine. What is actually load-bearing is that an offline admission is PROVISIONAL UNTIL RECONCILED: reconcile_offline_entry re-runs the real verification and records the servers own verdict beside the devices claim, so a fabricated entry becomes a flagged row in an audit log rather than an admitted guest. This table is also why the replay branch cannot just re-verify: a second scan of one credential is a DEPARTURE, so replaying an admission twice would check the visitor out. The recorded verdict is returned untouched instead. Read policy is is_community_admin ALONE, not gate staff: the person whose entries are being checked is not the person the check is for.'
}
// ---------------------------------------------------------------------------
