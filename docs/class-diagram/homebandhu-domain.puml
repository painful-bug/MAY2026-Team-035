@startuml HomeBandhu-Domain-Model
' ============================================================================
'  HomeBandhu — UML Class Diagram : DOMAIN MODEL
'  Multi-tenant residential-community management (Supabase Postgres + RLS)
'  Render: https://www.plantuml.com/plantuml/uml  or VS Code PlantUML extension
'  Companion file: homebandhu-architecture.puml (API / service / persistence)
' ============================================================================
skinparam dpi 130
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 55
skinparam shadowing false
skinparam classFontSize 12
skinparam classAttributeFontSize 11
skinparam packageStyle rectangle
skinparam wrapWidth 260
hide empty members

title HomeBandhu — UML Class Diagram (Domain Model)\nAll ids UUID · DateTime≡timestamptz · Money≡numeric(12,2) · JSON≡jsonb · v1.0

' ============================================================================
'  ABSTRACT BASE TYPES, INTERFACES, VALUE OBJECTS
' ============================================================================
package "Core Abstractions" #F5F5F5 {

  abstract class BaseEntity {
    - id : UUID {PK}
    - createdAt : DateTime {readOnly}
    - updatedAt : DateTime
    + touch() : void
    + isPersisted() : Boolean
  }

  abstract class TenantScopedEntity extends BaseEntity {
    # communityId : UUID {required}
    + belongsTo(c : Community) : Boolean
    + assertTenant(ctx : SecurityContext) : void
  }

  abstract class AuditableEvent extends BaseEntity {
    - eventType : String
    - metadata : JSON [0..1]
    - occurredAt : DateTime {readOnly}
    + isImmutable() : Boolean
  }

  abstract class AttachmentLink {
    - attachmentType : AttachmentType
    - createdAt : DateTime
  }

  interface Schedulable <<interface>> {
    + scheduledRange() : TimeRange
    + overlaps(o : Schedulable) : Boolean
    + assertNoOverlap() : void
  }
  interface Approvable <<interface>> {
    + approve(by : CommunityMembership) : void
    + reject(by : CommunityMembership, reason : String) : void
    + isApproved() : Boolean
  }
  interface Cancellable <<interface>> {
    + cancel(by : CommunityMembership, reason : String) : void
    + isCancelled() : Boolean
  }
  interface Auditable <<interface>> {
    + auditTrail() : List<AuditEvent>
  }

  class TimeRange <<value object>> {
    - startsAt : DateTime
    - endsAt : DateTime
    + durationMinutes() : Integer
    + overlaps(o : TimeRange) : Boolean
    + contains(at : DateTime) : Boolean
  }
  class Money <<value object>> {
    - amount : Decimal
    - currencyCode : CurrencyCode
    + plus(o : Money) : Money
    + minus(o : Money) : Money
    + isZero() : Boolean
  }
  class PostalAddress <<value object>> {
    - line1 : String {required}
    - line2 : String [0..1]
    - city : String {required}
    - state : String {required}
    - postalCode : String {required}
    - countryCode : CountryCode {required}
    + formatted() : String
  }
  class GeoPoint <<value object>> {
    - latitude : Decimal
    - longitude : Decimal
  }
}

' ============================================================================
'  NAVY — Identity & community foundation
' ============================================================================
package "Identity & Community  (navy)" #E8EAF6 {

  class AuthUser <<external system>> <<entity>> #ffffff {
    - id : UUID {PK}
    - email : String {unique}
    - emailConfirmedAt : DateTime [0..1]
    - createdAt : DateTime
    + isConfirmed() : Boolean
  }
  note top of AuthUser : Supabase Auth schema **auth.users**\nExternal — outside our deployment

  class Profile <<aggregate root>> {
    - id : UUID {PK, =auth.users.id}
    - displayName : String {required}
    - phoneE164 : String {unique}
    - phoneVerifiedAt : DateTime [0..1]
    - avatarObjectPath : String [0..1]
    - status : ProfileStatus
    - createdAt : DateTime
    - updatedAt : DateTime
    + verifyPhone(otp : String) : Boolean
    + updateAvatar(a : MediaAsset) : void
    + activeMemberships() : List<CommunityMembership>
    + membershipIn(c : Community) : Optional<CommunityMembership>
    + /isActive() : Boolean
  }

  class CommunityRegistrationRequest <<aggregate root>> {
    - id : UUID {PK}
    - associationName : String {required}
    - communityType : CommunityType
    - address : PostalAddress
    - applicantEmail : String {required}
    - applicantPhoneE164 : String {required}
    - otpVerifiedAt : DateTime [0..1]
    - status : RegistrationStatus
    - reviewNotes : Text [0..1]
    - reviewedByOperatorRef : String [0..1]
    - reviewedAt : DateTime [0..1]
    - createdAt : DateTime
    - updatedAt : DateTime
    + verifyOtp(code : String) : Boolean
    + approve(operatorRef : String) : Community
    + reject(reason : String) : void
    + /isVerified() : Boolean
  }

  class Community <<aggregate root>> <<tenant root>> {
    - id : UUID {PK}
    - name : String {required}
    - communityType : CommunityType
    - status : CommunityStatus
    - address : PostalAddress
    - location : GeoPoint [0..1]
    - activatedAt : DateTime [0..1]
    - archivedAt : DateTime [0..1]
    - createdAt : DateTime
    - updatedAt : DateTime
    + activate(admin : AdminMembership) : void
    + archive(reason : String) : void
    + transferAdmin(successor : CommunityMembership) : AdminMembership
    + activeAdmin() : AdminMembership
    + addBuilding(label : String) : Building
    + addUnit(label : String, t : UnitType) : Unit
    - assertSingleActiveAdmin() : void
  }
  note right of Community
    <b>{invariant}</b> activeAdmin must reference an
    <b>active ADMIN</b> membership of the SAME community;
    every ACTIVE community has exactly one.
  end note
}

' ============================================================================
'  TEAL — Buildings, units, occupancy
' ============================================================================
package "Buildings & Occupancy  (teal)" #E0F2F1 {

  class Building <<entity>> {
    - id : UUID {PK}
    - label : String {required}
    - buildingType : String [0..1]
    - sortOrder : Integer
    - location : GeoPoint [0..1]
    - status : String
    - createdAt : DateTime
    - updatedAt : DateTime
    + rename(label : String) : void
    + units() : List<Unit>
    + archive() : void
  }

  class Unit <<aggregate root>> {
    - id : UUID {PK}
    - unitLabel : String {unique per community}
    - unitType : UnitType
    - floorNumber : Integer [0..1]
    - areaSqft : Decimal [0..1]
    - location : GeoPoint [0..1]
    - status : UnitStatus
    - archivedAt : DateTime [0..1]
    - createdAt : DateTime
    - updatedAt : DateTime
    + primaryContact() : UnitResidency
    + transferPrimaryContact(to : UnitResidency, by : CommunityMembership) : void
    + activeResidents() : List<UnitResidency>
    + /outstandingBalance() : Money
    + archive() : void
  }
  note right of Unit
    <b>{invariant}</b> exactly one UnitResidency with
    isPrimaryContact=true AND status=ACTIVE (partial UQ).
    Transfer: current primary nominates an active resident
    of the same unit; admin appoints only if none active.
  end note

  class UnitResidency <<entity>> {
    - id : UUID {PK}
    - occupancyType : OccupancyType
    - status : MembershipStatus
    - isPrimaryContact : Boolean
    - moveInDate : Date [0..1]
    - moveOutDate : Date [0..1]
    - createdAt : DateTime
    - updatedAt : DateTime
    + makePrimary() : void
    + nominateSuccessor(next : UnitResidency) : void
    + endOccupancy(on : Date, reason : String) : void
    + /isActive() : Boolean
  }
}

' ============================================================================
'  GOLD — Roles, staff, departments, vendors, skills
' ============================================================================
package "Roles, Staff & Skills  (gold)" #FFF8E1 {

  abstract class CommunityMembership <<aggregate root>> {
    - id : UUID {PK}
    - role : MembershipRole {readOnly}
    - status : MembershipStatus
    - activatedAt : DateTime [0..1]
    - endedAt : DateTime [0..1]
    - endReason : String [0..1]
    - createdAt : DateTime
    - updatedAt : DateTime
    + activate() : void
    + end(reason : String) : void
    + /isActive() : Boolean
    + can(action : String) : Boolean
    + scopeCommunityIds() : Set<UUID>
    - assertSingleCommunityScope() : void
  }
  note left of CommunityMembership
    <b>{enum}</b> role ∈ {RESIDENT, WORKER, SECURITY,
    MANAGER, ADMIN}. Role lives HERE, never on Profile.
    There is NO public users(id, role) class.
    <b>{scope}</b> RESIDENT/ADMIN: one active membership
    across all communities. WORKER/SECURITY/MANAGER:
    many communities. Staff & non-staff not mixed.
  end note

  class ResidentMembership {
    ' {role = RESIDENT} — single community only
    + raiseComplaint(...) : Complaint
    + requestBooking(...) : AmenityBookingSeries
    + preApproveVisitor(...) : VisitorAccessRequest
    + payInvoice(i : Invoice, m : PaymentMethod) : Payment
  }
  class WorkerMembership {
    ' {role = WORKER} — multi-community
    + acceptAssignment(a : WorkOrderAssignment) : void
    + declineAssignment(a : WorkOrderAssignment, reason : String) : void
    + propose(range : TimeRange, quote : Money) : WorkOrderProposal
    + submitCompletionEvidence(wo : WorkOrder, m : MediaAsset) : void
  }
  class SecurityMembership {
    ' {role = SECURITY} — visitor operations only
    + validateAccessCode(code : String) : VisitorAccessRequest
    + checkIn(r : VisitorAccessRequest) : void
    + checkOut(r : VisitorAccessRequest) : void
  }
  class ManagerMembership {
    ' {role = MANAGER} — multi-community
    + assignWorkOrder(wo : WorkOrder, s : StaffAssignment) : WorkOrderAssignment
    + manageStaff(a : StaffAssignment) : void
    + overrideBooking(o : AmenityBookingOccurrence) : void
  }
  class AdminMembership {
    ' {role = ADMIN} — exactly one active per community
    + inviteResident(u : Unit, email : String) : ResidentInvite
    + grantRole(p : Profile, r : MembershipRole) : CommunityMembership
    + issueInvoice(...) : Invoice
    + publishPolicy(p : Policy) : PolicyRevision
    + transferAdminRights(to : CommunityMembership) : void
  }
  note bottom of SecurityMembership
    <b>{security}</b> SECURITY has NO broad resident-
    directory association. Contact lookup for an active
    visitor request is a narrow audited RPC only.
  end note

  class Department <<entity>> {
    - id : UUID {PK}
    - name : String {unique per community}
    - description : Text [0..1]
    - status : String
    - createdAt : DateTime
    - updatedAt : DateTime
    + activate() : void
    + deactivate() : void
    + /headcount() : Integer
  }

  class Vendor <<entity>> {
    ' global scope — shared across communities
    - id : UUID {PK}
    - legalName : String {required}
    - contactName : String [0..1]
    - contactEmail : String [0..1]
    - contactPhoneE164 : String [0..1]
    - address : Text [0..1]
    - status : String
    - createdAt : DateTime
    - updatedAt : DateTime
    + deactivate() : void
    + assignments() : List<StaffAssignment>
  }

  class StaffAssignment <<entity>> {
    - id : UUID {PK}
    - employmentType : EmploymentType
    - employeeCode : String [0..1]
    - jobTitle : String [0..1]
    - status : StaffAssignmentStatus
    - assignedAt : DateTime
    - endedAt : DateTime [0..1]
    - createdAt : DateTime
    - updatedAt : DateTime
    + addSkill(s : Skill, level : ProficiencyLevel) : StaffSkill
    + hasSkill(name : String) : Boolean
    + isAvailable(range : TimeRange) : Boolean
    + acceptedAssignments() : List<WorkOrderAssignment>
    + end(reason : String) : void
  }
  note bottom of StaffAssignment : {invariant} one active staff assignment per membership

  class Skill <<entity>> {
    ' global scope
    - id : UUID {PK}
    - name : String {unique}
    - category : String [0..1]
    - description : Text [0..1]
    - status : String
    - createdAt : DateTime
    - updatedAt : DateTime
  }
  note right of Skill
    <b>{skill ≠ role}</b> "technician" and "serviceman"
    are WORKER skills, not permission roles.
  end note

  class StaffSkill <<association class>> {
    - proficiencyLevel : ProficiencyLevel [0..1]
    - verifiedAt : DateTime [0..1]
    - createdAt : DateTime
    + verify(by : CommunityMembership) : void
    + /isVerified() : Boolean
  }

  class WorkerAvailabilityRule <<entity>> {
    - id : UUID {PK}
    - weekday : Weekday
    - startTime : Time
    - endTime : Time
    - effectiveFrom : Date
    - effectiveTo : Date [0..1]
    - status : String
    - createdAt : DateTime
    - updatedAt : DateTime
    + covers(at : DateTime) : Boolean
    + toRangeOn(day : Date) : TimeRange
  }
  class WorkerUnavailability <<entity>> {
    - id : UUID {PK}
    - range : TimeRange
    - reason : String [0..1]
    - status : String
    - createdAt : DateTime
    - updatedAt : DateTime
    + blocks(range : TimeRange) : Boolean
  }
}

' ============================================================================
'  ONBOARDING
' ============================================================================
package "Resident Onboarding  (navy/teal)" #EDE7F6 {

  class ResidentInvite <<aggregate root>> {
    - id : UUID {PK}
    - recipientEmail : String {required}
    - status : InviteStatus
    - authInviteSentAt : DateTime [0..1]
    - expiresAt : DateTime
    - acceptedAt : DateTime [0..1]
    - revokedAt : DateTime [0..1]
    - revocationReason : String [0..1]
    - createdAt : DateTime
    - updatedAt : DateTime
    + send() : void
    + revoke(by : CommunityMembership, reason : String) : void
    + reissue() : ResidentInvite
    + accept(p : Profile) : UnitResidency
    + /isRedeemable() : Boolean
  }
  note bottom of ResidentInvite
    <b>{security}</b> single-use; only token/code DIGESTS
    are stored; redeem is compare-and-set (no double redeem).
  end note

  class AccessRequest <<aggregate root>> {
    - id : UUID {PK}
    - applicantName : String {required}
    - applicantEmail : String {required}
    - applicantPhoneE164 : String {required}
    - requestedOccupancyType : OccupancyType
    - status : AccessRequestStatus
    - reviewedAt : DateTime [0..1]
    - decisionReason : String [0..1]
    - createdAt : DateTime
    - updatedAt : DateTime
    + approve(by : CommunityMembership) : ResidentInvite
    + reject(by : CommunityMembership, reason : String) : void
    + withdraw() : void
  }
}

' ============================================================================
'  RED — Complaints, work orders, scheduling
' ============================================================================
package "Complaints & Work Orders  (red)" #FFEBEE {

  class Complaint <<aggregate root>> {
    - id : UUID {PK}
    - title : String {required}
    - description : Text {required}
    - category : String
    - urgency : Urgency
    - status : ComplaintStatus
    ' 0050: which department owns this. Null is a real state and not a gap --
    ' it means the routing rule found nothing and the complaint is waiting in
    ' the administrator's triage queue.
    - departmentId : UUID [0..1]
    - submittedAt : DateTime
    - resolvedAt : DateTime [0..1]
    - createdAt : DateTime
    - updatedAt : DateTime
    + changeStatus(next : ComplaintStatus, actor : CommunityMembership, note : String) : ComplaintEvent
    + escalate() : void
    + raiseWorkOrder(dept : Department) : WorkOrder
    + resolve() : void
    + reopen(reason : String) : void
    ' Category first, the resident's own guess second, nothing third. The rule
    ' lives in resolve_complaint_department (0050) and has exactly one home.
    + routeToDepartment(category : String, residentChoice : Department [0..1]) : Department [0..1]
  }

  ' 0050. A supervisor saying a complaint belongs elsewhere, and the answer from
  ' the manager of the department GIVING IT UP -- never the one receiving it.
  ' A supervisor who could move work out of their own department could empty it.
  class ComplaintDepartmentRequest <<entity>> {
    - id : UUID {PK}
    ' Nullable: "this is not ours" is worth saying without knowing whose it is.
    ' Accepted with nothing named, the complaint returns to the triage queue.
    - toDepartmentId : UUID [0..1]
    - reason : Text [0..1]
    - status : RequestStatus
    - decidedAt : DateTime [0..1]
    - createdAt : DateTime
    + accept(destination : Department [0..1]) : void
    + reject() : void
  }

  class ComplaintEvent <<event>> {
    - id : UUID {PK}
    - eventType : String
    - previousStatus : ComplaintStatus [0..1]
    - newStatus : ComplaintStatus [0..1]
    - note : Text [0..1]
    - metadata : JSON [0..1]
    - createdAt : DateTime
  }

  class WorkOrder <<aggregate root>> {
    - id : UUID {PK}
    - title : String {required}
    - description : Text {required}
    - serviceCategory : String
    - priority : Priority
    - status : WorkOrderStatus
    - preferredRange : TimeRange [0..1]
    - scheduledRange : TimeRange [0..1]
    - escalationRequired : Boolean
    - resolvedAt : DateTime [0..1]
    - closedAt : DateTime [0..1]
    - createdAt : DateTime
    - updatedAt : DateTime
    + assign(s : StaffAssignment, by : CommunityMembership) : WorkOrderAssignment
    + schedule(range : TimeRange) : void
    + recordView(s : StaffAssignment) : WorkOrderView
    + attachEvidence(m : MediaAsset, t : AttachmentType) : WorkOrderAttachment
    + verifyCompletion(method : VerificationMethod) : WorkOrderCompletionVerification
    + close() : void
  }

  class WorkOrderAssignment <<entity>> {
    - id : UUID {PK}
    - status : AssignmentStatus
    - assignedAt : DateTime
    - acceptedAt : DateTime [0..1]
    - declinedAt : DateTime [0..1]
    - declineReason : String [0..1]
    - scheduledRange : TimeRange [0..1]
    - completedAt : DateTime [0..1]
    - createdAt : DateTime
    - updatedAt : DateTime
    + accept() : void
    + decline(reason : String) : void
    + complete(at : DateTime) : void
    + overlaps(o : WorkOrderAssignment) : Boolean
  }
  note bottom of WorkOrderAssignment
    <b>{exclusion}</b> accepted assignments of one worker
    must not overlap: EXCLUDE USING gist
    (staff_assignment_id WITH =, range WITH &&).
    Proposals may overlap until accepted.
  end note

  class WorkOrderProposal <<entity>> {
    - id : UUID {PK}
    - proposalVersion : Integer
    - proposedRange : TimeRange
    - quotedAmount : Money [0..1]
    - status : ProposalStatus
    - note : Text [0..1]
    - expiresAt : DateTime [0..1]
    - acceptedAt : DateTime [0..1]
    - createdAt : DateTime
    - updatedAt : DateTime
    + counter(range : TimeRange, quote : Money) : WorkOrderProposal
    + accept() : WorkOrderAssignment
    + reject(reason : String) : void
    + expire() : void
  }

  class WorkOrderView <<association class>> {
    - firstViewedAt : DateTime
    - lastViewedAt : DateTime
    - viewCount : Integer
    + touch() : void
  }

  class WorkOrderCompletionVerification <<entity>> {
    - id : UUID {PK}
    - verificationMethod : VerificationMethod
    - otpDigest : String [0..1]
    - verifiedAt : DateTime [0..1]
    - notes : Text [0..1]
    - createdAt : DateTime
    + issueOtp() : String
    + verify(submitted : String) : Boolean
  }
}

' ============================================================================
'  AMBER — Service personnel: hiring, dispatch and departure  (0034–0043)
'
'  The people in this package are the only ones in the model who exist BEFORE
'  any community has heard of them. A ServiceProvider is global — one row per
'  person, not per society — and becomes a StaffAssignment in each community
'  that hires them. That is the whole reason it is a separate class from
'  StaffAssignment rather than a flag on it: skills, availability, coordinates
'  and the "taking work" switch belong to the person and are asked about by
'  somebody who is on no roster at all.
' ============================================================================
package "Service Personnel  (amber)" #FFF3E0 {

  class ServiceProvider <<aggregate root>> {
    ' global scope — one per profile, across every community
    - id : UUID {PK}
    - profileId : UUID {unique, FK}
    - displayName : String {required}
    - headline : String [0..1]
    - bio : Text [0..1]
    - phoneE164 : String [0..1]
    - latitude : Decimal(9,6) [0..1]
    - longitude : Decimal(9,6) [0..1]
    - location : Geography(Point,4326) {derived}
    - serviceRadiusKm : Decimal(6,2)
    - status : String
    - isAvailable : Boolean
    - createdAt : DateTime
    - updatedAt : DateTime
    + serviceableCommunities() : List<Community>
    + applyTo(d : Department, message : String) : ServiceApplication
    + goOffline() : void
  }
  note right of ServiceProvider
    <b>{location is generated}</b> latitude/longitude are the
    source of truth; the geography column is derived and
    GiST-indexed. Dropping PostGIS costs one column and one
    index — every API shape is unchanged (D7).
  end note

  class ServiceProviderSkill <<association class>> {
    - proficiencyLevel : SmallInt [0..1]
  }
  note bottom of ServiceProviderSkill
    <b>{skills belong to the PERSON, not the posting}</b> (D2).
    The search that matters — "which communities need my
    trades" — runs before anybody has hired them. Keyed to a
    roster row it returns nothing for exactly the people who
    need it. Supersedes StaffSkill.
  end note

  class SkillCategory <<entity>> {
    - skillId : UUID {PK, FK}
    - complaintCategoryId : UUID {PK, FK}
  }
  note bottom of SkillCategory
    <b>{there is no department_skills table}</b> A department
    declares complaint categories; a skill maps to categories;
    so "this department needs this skill" is DERIVABLE by a
    join rather than stored. One table not written.
    Note: this model carries a complaint's category as a String
    on Complaint, so the far end of this link is the
    complaint_categories table rather than a class here.
  end note

  class ServiceApplication <<entity>> {
    - id : UUID {PK}
    - direction : ApplicationDirection
    - status : ApplicationStatus
    - message : Text [0..1]
    - rank : StaffRank [0..1]
    - jobTitle : String [0..1]
    - shift : Shift [0..1]
    - decisionNote : Text [0..1]
    - decidedAt : DateTime [0..1]
    - createdAt : DateTime
    - updatedAt : DateTime
    + accept(terms : HiringTerms) : StaffAssignment
    + reject(note : String) : void
    + withdraw() : void
  }
  note bottom of ServiceApplication
    <b>{one negotiation, two ends}</b> An application and an
    invitation are one table because accepting does the same
    three writes either way — membership, roster row, decision
    — in ONE transaction. `direction` decides who may answer,
    which is why it is a column and not a comment.
    {invariant} one open negotiation per (department, provider)
  end note

  class BlacklistedServiceProvider <<entity>> {
    - id : UUID {PK}
    - reason : Text {required}
    - blacklistedAt : DateTime
    - revokedAt : DateTime [0..1]
  }
  note right of BlacklistedServiceProvider
    <b>{not BlacklistedResident}</b> (D10). That table is keyed
    on a profile and is enforced inside community search, so
    reusing it would bar this person from LIVING here. A plumber
    a community will not hire has not been refused a flat.
  end note

  class StaffDeparture <<entity>> {
    - id : UUID {PK}
    - initiatedBy : DepartureInitiator
    - reason : Text [0..1]
    - status : DepartureStatus
    - requestedEffectiveAt : DateTime [0..1]
    - effectiveAt : DateTime [0..1]
    - decisionNote : Text [0..1]
    - decidedAt : DateTime [0..1]
    - createdAt : DateTime
    - updatedAt : DateTime
    + conflicts() : List<Commitment>
    + coverage() : List<CoverageAnswer>
    + reassign(item : Commitment, to : StaffAssignment [0..1]) : void
    + approve(effectiveAt : DateTime [0..1]) : void
    + reject(note : String) : void
  }
  note bottom of StaffDeparture
    <b>{leaving is a dated state the manager decides}</b> (0043,
    reworked 0045). A pending row bars the dispatch sweep for
    work the leave would strand — everything when undated, the
    date onward (plus unscheduled work) when dated — and two
    triggers stand behind the sweep. approve() picks the leave
    date (requested or later) and RELEASES conflicting work to
    the pool at queue priority just below urgent; a timekeeper
    task removes the person at the date. <i>Until 2026-08-10
    approve() raised while anything was outstanding — the PO
    overturned that; the gate survives only on the direct
    remove, which has no release step.</i> There is deliberately
    NO handover status: that is pending with a non-zero count.
    {invariant} one open departure per roster row
  end note

  class DirectMessageThread <<aggregate root>> {
    - id : UUID {PK}
    - kind : DmThreadKind
    - participantANameSnapshot : String
    - participantBNameSnapshot : String
    - lockedAt : DateTime [0..1]
    - lastMessageAt : DateTime [0..1]
    - createdAt : DateTime
    + post(author : Profile, body : String) : DirectMessage
    + lock() : void
  }
  note right of DirectMessageThread
    <b>{two people, one thread}</b> (0046). Pair stored in
    canonical order (a &lt; b), one row per pair per community.
    dm_pair_allowed is the single reach rule: both active
    members, and either runs the place (admin/manager — the
    committee IS the admin role) or they share a department.
    A work_order thread joins the accepted worker to the
    complainant and LOCKS when the job ends: readable history,
    closed channel — the PO's protection, verbatim. Names are
    snapshots because profiles is self-read-only.
  end note

  class DirectMessage <<entity>> {
    - id : UUID {PK}
    - body : Text {required, 1..4000}
    - createdAt : DateTime
    ' null author = a system line ("this conversation is
    ' closed"), written only by the database.
  }

  class Conversation <<aggregate root>> {
    - id : UUID {PK}
    - lastMessageAt : DateTime [0..1]
    - createdAt : DateTime
    + post(author : Party, body : String) : ConversationMessage
  }
  note right of Conversation
    <b>{no participants table}</b> One thread per (department,
    provider), so there is no thread-creation step and no
    duplicate threads — the unique constraint is the whole
    concurrency story. Participation is DERIVABLE: the
    department's managers and supervisors, plus that provider,
    which is exactly what the RLS policy computes.
  end note

  class ConversationMessage <<entity>> {
    - id : UUID {PK}
    - body : Text {required, 1..4000}
    - createdAt : DateTime
    + authorSide() : String
  }

  class DispatchTask <<entity>> {
    - id : UUID {PK}
    - kind : DispatchTaskKind
    - dueAt : DateTime
    - attempts : SmallInt
    - claimedAt : DateTime [0..1]
    - completedAt : DateTime [0..1]
    - lastError : Text [0..1]
    - createdAt : DateTime
  }
  note bottom of DispatchTask
    <b>{a lease, not a tombstone}</b> Claimed with FOR UPDATE
    SKIP LOCKED so two app processes cannot double-fire, and
    re-armed rather than duplicated when a job is rescheduled.
    Python owns only WHEN; every decision is a SECURITY DEFINER
    function, so the notification is written inside the same
    transaction as the assignment it announces.
  end note

  class SecurityPost <<entity>> {
    - id : UUID {PK}
    - name : String {required}
    - locationText : String [0..1]
    - latitude : Decimal(9,6) [0..1]
    - longitude : Decimal(9,6) [0..1]
    - isActive : Boolean
  }

  class SecurityShift <<entity>> {
    - id : UUID {PK}
    - startsAt : DateTime
    - endsAt : DateTime
    - status : ShiftStatus
    - notes : Text [0..1]
    - createdAt : DateTime
    - updatedAt : DateTime
  }
  note right of SecurityShift
    <b>{same exclusion constraint as WorkOrderAssignment}</b>
    A guard cannot be at two posts at once for exactly the
    reason a plumber cannot be at two addresses. The PREDICATE
    differs and has to: assignments constrain only 'accepted'
    rows, because one slot is offered to five workers; nobody
    offers a shift to five guards, so this covers everything
    except 'cancelled'.
  end note

  class MaterialMovement <<entity>> {
    - id : UUID {PK}
    - direction : MovementDirection
    - description : Text {required}
    - quantity : Decimal [0..1]
    - unit : String [0..1]
    - isReturnable : Boolean
    - expectedReturnAt : DateTime [0..1]
    - returnedAt : DateTime [0..1]
    - carrierName : String [0..1]
    - vehicleNumber : String [0..1]
    - recordedAt : DateTime
    - sourceClientId : String [0..1]
  }

  class WaterTankerLog <<entity>> {
    - id : UUID {PK}
    - supplierName : String [0..1]
    - tankerNumber : String [0..1]
    - volumeLitres : Decimal [0..1]
    - driverName : String [0..1]
    - driverPhoneE164 : String [0..1]
    - arrivedAt : DateTime
    - departedAt : DateTime [0..1]
    - sourceClientId : String [0..1]
  }
  note bottom of WaterTankerLog
    <b>{two tables, not one typed table}</b> (D12). These two
    share almost no columns, are named by two separate user
    stories, and produce two separate reports. One table with a
    kind and a details jsonb would be null-heavy on both halves
    and would push validation out of the schema into Python.
  end note

  class SecurityIncident <<entity>> {
    - id : UUID {PK}
    - category : String
    - severity : String
    - summary : String {required}
    - details : Text [0..1]
    - occurredAt : DateTime
    - status : String
  }

  class OfflineReconcileLog <<entity>> {
    - id : UUID {PK}
    - sourceClientId : String {unique}
    - recordedAt : DateTime
  }
  note right of OfflineReconcileLog
    <b>{the idempotency key}</b> A gate that was offline replays
    what it recorded; a replay must not double-write. Every
    register table carries sourceClientId for the same reason.
  end note
}

